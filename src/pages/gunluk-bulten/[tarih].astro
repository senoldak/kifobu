---
// Günlük bültenin kalıcı tarihli sayfası (/gunluk-bulten/YYYY-AA-GG/): o günün 18:00 kampanya kaydı, o gün
// yayımlanan bülten yazıları ve haberler (src/lib/gunler.ts). Kampanya kaydı ya da en az 3 haberi olmayan gün
// "noindex, follow" kalır. /gunluk-bulten/2/ gibi bölüm sayfalarıyla çakışmaz: buradaki parametre yalnız tarihtir.
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import Base from '../../layouts/Base.astro';
import HaberSatiri from '../../components/HaberSatiri.astro';
import PlatformAdi from '../../components/PlatformAdi.astro';
import Yol from '../../components/Yol.astro';
import { dizinVerisi, platformUrl } from '../../lib/dizin';
import { gunUrl, type BultenGunu } from '../../lib/gunler';
import { kampanyalar as kampanyaListesi } from '../../lib/kampanya';
import { paraTam, yuzdeBicim } from '../../lib/arsiv/bicim.ts';
import { sayfaLd } from '../../lib/ld';
import { RISK_NOTU, formatDate, formatNumber } from '../../lib/site';
import { newsUrl, type Haber } from '../../lib/news';

export async function getStaticPaths() {
  const { gunler, kayitlar } = await dizinVerisi();
  const slugHaritasi = new Map(kampanyaListesi(kayitlar).map((k) => [`${k.platform}|${k.ad}`, k.slug]));
  return gunler.map((g, i) => ({
    params: { tarih: g.tarih },
    props: { g, yeni: gunler[i - 1]?.tarih, eski: gunler[i + 1]?.tarih, slugHaritasi },
  }));
}

interface Props {
  g: BultenGunu<Haber>;
  yeni?: string;
  eski?: string;
  slugHaritasi: Map<string, string>;
}

const { g, yeni, eski, slugHaritasi } = Astro.props;
const gun = (t: string) => formatDate(new Date(`${t}T12:00:00+03:00`));
const tarihAd = gun(g.tarih);
const yol = gunUrl(g.tarih);
const k = g.kayit;
const gunlukGiris = k ? k.girisimler.reduce((s, x) => s + (x.bugun ?? 0), 0) : 0;
const parcalar = [
  k && `${k.girisimler.length} kampanya, günlük giriş ${paraTam(gunlukGiris)}`,
  g.haberler.length > 0 && `${g.haberler.length} haber`,
].filter(Boolean);
const aciklama = `${tarihAd} günlük kitle fonlama bülteni (Bülten ${formatNumber(g.sayi)})${parcalar.length ? `: ${parcalar.join('; ')}` : ''}.`;
const baslik = `Günlük Bülten ${tarihAd}`;
const adimlar = [{ ad: 'Anasayfa', url: '/' }, { ad: 'Günlük Bülten', url: '/gunluk-bulten/' }, { ad: 'Bülten günleri', url: '/gunluk-bulten/gunler/' }, { ad: tarihAd, url: yol }];
const jsonLd = sayfaLd({
  site: Astro.site!,
  yol,
  ad: baslik,
  aciklama,
  ogeler: [...g.bultenler, ...g.haberler].map(newsUrl),
  adimlar,
  ek: { datePublished: g.tarih, temporalCoverage: g.tarih },
});
---

<Base title={baslik} description={aciklama} noindex={!g.indeks}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  </Fragment>
  <div slot="tahta" class="kategori-bas">
    <h1 class="kategori-isim">{tarihAd}</h1>
    <p class="kategori-sayi">Bülten {formatNumber(g.sayi)}</p>
  </div>

  <Yol adimlar={adimlar} />

  {
    k && (
      <section class="bolum bolum-ilk" aria-labelledby="gun-kampanyalar">
        <div class="bolum-bas">
          <h2 class="bolum-baslik" id="gun-kampanyalar">Kampanyalar · 18:00 kaydı</h2>
          <a href="/kampanya/">Bütün kampanyalar</a>
        </div>
        <div class="tablo-kap">
          <table class="veri-tablo">
            <caption class="sr-only">{tarihAd} kampanya kaydı</caption>
            <thead>
              <tr>
                <th scope="col">Girişim</th>
                <th scope="col">Platform</th>
                <th scope="col" class="sayi">Günlük giriş</th>
                <th scope="col" class="sayi">Toplanan</th>
                <th scope="col" class="sayi">Hedef</th>
                <th scope="col" class="sayi">Gerçekleşme</th>
                <th scope="col">Durum</th>
              </tr>
            </thead>
            <tbody>
              {k.girisimler.map((x) => {
                const slug = slugHaritasi.get(`${x.platform}|${x.ad}`);
                return (
                  <tr>
                    <th scope="row">{slug ? <a href={`/kampanya/${slug}/`}>{x.ad}</a> : x.ad}</th>
                    <td>
                      <PlatformAdi ad={x.platform} href={platformUrl(x.platform)} />
                    </td>
                    <td class:list={['sayi', { 'sayi--artis': (x.bugun ?? 0) > 0 }]}>
                      {x.veriAlinamadi ? 'Veri alınamadı' : paraTam(x.bugun)}
                      {x.birikmis && '*'}
                    </td>
                    <td class="sayi">{paraTam(x.alinan)}</td>
                    <td class="sayi">{paraTam(x.hedef)}</td>
                    <td class="sayi">{yuzdeBicim(x.yuzde)}</td>
                    <td>{x.durum}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        {k.platformlar.length > 0 && (
          <div class="tablo-kap">
            <table class="veri-tablo">
              <caption class="sr-only">{tarihAd} platform dağılımı</caption>
              <thead>
                <tr>
                  <th scope="col">Platform</th>
                  <th scope="col" class="sayi">Günlük giriş</th>
                  <th scope="col" class="sayi">Toplam</th>
                </tr>
              </thead>
              <tbody>
                {k.platformlar.map((p) => (
                  <tr>
                    <th scope="row">
                      <PlatformAdi ad={p.ad} href={platformUrl(p.anahtar)} />
                    </th>
                    <td class:list={['sayi', { 'sayi--artis': (p.bugun ?? 0) > 0 }]}>{paraTam(p.bugun)}</td>
                    <td class="sayi">{paraTam(p.toplam)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <p class="dizin-not">
          Günlük giriş, toplamın bir önceki 18:00 kaydına göre farkıdır; serinin ilk günü hesaplanmaz (—). * Önceki gün(ler)in
          girişini de içerir. {RISK_NOTU}
        </p>
      </section>
    )
  }

  {
    g.bultenler.length > 0 && (
      <section class="bolum" aria-labelledby="gun-bultenler">
        <div class="bolum-bas">
          <h2 class="bolum-baslik" id="gun-bultenler">Bülten yazıları</h2>
        </div>
        <div class="satir-izgara">
          {g.bultenler.map((h) => (
            <HaberSatiri haber={h} showCategory={false} withTime />
          ))}
        </div>
      </section>
    )
  }

  {
    g.haberler.length > 0 && (
      <section class="bolum" aria-labelledby="gun-haberler">
        <div class="bolum-bas">
          <h2 class="bolum-baslik" id="gun-haberler">{tarihAd} haberleri</h2>
        </div>
        <div class="satir-izgara">
          {g.haberler.map((h) => (
            <HaberSatiri haber={h} withTime />
          ))}
        </div>
      </section>
    )
  }

  <nav class="sayfalama" aria-label="Bülten günleri">
    {yeni ? <a href={gunUrl(yeni)} rel="prev">← {gun(yeni)}</a> : <span />}
    <a class="sayfalama-bilgi" href="/gunluk-bulten/gunler/">Bütün günler</a>
    {eski ? <a href={gunUrl(eski)} rel="next">{gun(eski)} →</a> : <span />}
  </nav>
</Base>
