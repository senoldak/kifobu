---
// Çeyrek sektör raporu (/rapor/YYYY-cN/) ve rapor dizini (/rapor/). Rakamlar yalnız kifobu kayıtlarından sayılır
// (src/lib/rapor.ts). Bitmemiş ya da verisi yetersiz çeyreğin sayfası üretilmez; hiç rapor yoksa dizin de üretilmez.
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import Base from '../../layouts/Base.astro';
import Yol from '../../components/Yol.astro';
import { platformUrl, yayimlananRaporlar } from '../../lib/dizin';
import { gommeKodu, raporKartAlt } from '../../kapak/rapor-kart';
import { KAPAK_G, KAPAK_Y } from '../../kapak/ciz';
import { EN_AZ_RAPOR_HABERI, kaynakNotu, type CeyrekOzeti } from '../../lib/rapor';
import { sayfaLd } from '../../lib/ld';
import { categoryName, formatMoneyShort, formatNumber, formatDate, RISK_NOTU } from '../../lib/site';

export async function getStaticPaths() {
  const { raporlar } = await yayimlananRaporlar();
  if (raporlar.length === 0) return [];
  return [
    { params: { ceyrek: undefined }, props: { raporlar } },
    ...raporlar.map((o) => ({ params: { ceyrek: o.ceyrek.slug }, props: { raporlar, o } })),
  ];
}

interface Props {
  raporlar: CeyrekOzeti[];
  o?: CeyrekOzeti;
}

const { raporlar, o } = Astro.props;
const gun = (t: string) => formatDate(new Date(`${t}T12:00:00+03:00`));
const yol = o ? `/rapor/${o.ceyrek.slug}/` : '/rapor/';
const ad = o ? `Kitle fonlama ve girişim yatırımları: ${o.ceyrek.ad}` : 'Çeyrek raporları';
const aciklama = o
  ? `kifobu ${o.ceyrek.ad} raporu: ${o.haberSayisi} haber, ${o.yatirimHaberi} yatırım haberi, ${o.kampanya.kampanyaSayisi} kitle fonlama kampanyası. Yalnız kifobu kayıtlarından sayılan rakamlar.`
  : 'kifobu çeyrek raporları: kitle fonlama kampanyaları ve girişim yatırımı haberlerinden sayılan dönemsel rakamlar.';
const adimlar = [{ ad: 'Anasayfa', url: '/' }, { ad: 'Raporlar', url: '/rapor/' }, ...(o ? [{ ad: o.ceyrek.ad, url: yol }] : [])];
const sayfaUrl = new URL(yol, Astro.site).href;
const gorsel = o ? `/rapor/${o.ceyrek.slug}.png` : undefined;
const csv = o ? `/rapor/${o.ceyrek.slug}.csv` : undefined;
const orgRef = { '@id': `${new URL('/', Astro.site).href}#organization` };
const jsonLd = sayfaLd({
  site: Astro.site!,
  yol,
  ad,
  aciklama,
  tur: o ? 'Report' : 'CollectionPage',
  ogeler: o ? undefined : raporlar.map((r) => `/rapor/${r.ceyrek.slug}/`),
  adimlar,
  ek: o
    ? {
        temporalCoverage: `${o.ceyrek.bas}/${o.ceyrek.son}`,
        author: orgRef,
        primaryImageOfPage: { '@type': 'ImageObject', url: new URL(gorsel!, Astro.site).href, width: KAPAK_G, height: KAPAK_Y },
        about: { '@id': `${sayfaUrl}#veri` },
      }
    : {},
});
// Rapor rakamları Dataset olarak da tanımlanır (Google Dataset Search); dağıtım CSV'dir.
if (o) {
  (jsonLd['@graph'] as object[]).push({
    '@type': 'Dataset',
    '@id': `${sayfaUrl}#veri`,
    name: `${ad} (kifobu)`,
    description: `${aciklama} Haber ve yatırım haberi sayıları bölüme, tura ve para birimine göre; kitle fonlama kampanyaları platforma göre.`,
    url: sayfaUrl,
    inLanguage: 'tr-TR',
    temporalCoverage: `${o.ceyrek.bas}/${o.ceyrek.son}`,
    keywords: ['kitle fonlama', 'paya dayalı kitle fonlaması', 'girişim yatırımı', 'girişim sermayesi', o.ceyrek.ad],
    creator: orgRef,
    publisher: orgRef,
    isAccessibleForFree: true,
    creditText: kaynakNotu(o.ceyrek, sayfaUrl),
    distribution: [{ '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: new URL(csv!, Astro.site).href }],
  });
}
const kaynak = o ? kaynakNotu(o.ceyrek, sayfaUrl) : '';
const gomme = o ? gommeKodu(o, sayfaUrl, new URL(gorsel!, Astro.site).href) : '';
---

<Base title={ad} description={aciklama} image={gorsel} imageWidth={o ? KAPAK_G : undefined} imageHeight={o ? KAPAK_Y : undefined} imageAlt={o ? raporKartAlt(o) : undefined}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div slot="tahta" class="kategori-bas">
    <h1 class="kategori-isim">{o ? o.ceyrek.ad : 'Raporlar'}</h1>
    <p class="kategori-sayi">{o ? 'Çeyrek raporu' : `${raporlar.length} rapor`}</p>
  </div>

  <Yol adimlar={adimlar} />

  {
    !o ? (
      <ul class="dizin-liste">
        {raporlar.map((r) => (
          <li>
            <a href={`/rapor/${r.ceyrek.slug}/`}>{r.ceyrek.ad}</a>
          </li>
        ))}
      </ul>
    ) : (
      <article class="makale">
        <div class="metin">
          <p>
            Bu rapor {gun(o.ceyrek.bas)} – {gun(o.ceyrek.son)} arasında kifobu’da yayımlanan haberlerin künyelerinden ve
            günlük bültenin 18:00 kampanya kayıtlarından sayılmıştır. Rakamlar kifobu’nun yayımladığı haberlerle sınırlıdır;
            sektörün tamamını göstermez.
          </p>

          <h2>Haberler</h2>
          <p>
            Çeyrekte {formatNumber(o.haberSayisi)} haber yayımlandı; bunların {formatNumber(o.yatirimHaberi)} tanesi tutarı
            belli bir yatırım ya da fonlama haberidir.
          </p>
          <table>
            <thead>
              <tr><th scope="col">Bölüm</th><th scope="col">Haber</th></tr>
            </thead>
            <tbody>
              {o.bolumler.map((b) => (
                <tr><td><a href={`/${b.category}/`}>{categoryName(b.category)}</a></td><td>{formatNumber(b.adet)}</td></tr>
              ))}
            </tbody>
          </table>

          {o.tutarlar.length > 0 && (
            <>
              <h2>Haberlerdeki yatırım tutarları</h2>
              <p>
                Tutarlar para birimine göre ayrı toplanmıştır; kur çevirisi yapılmamıştır.
                {o.tutarDisi > 0 && ` Fon kapanışı ve halka arz haberleri (${formatNumber(o.tutarDisi)} haber) girişim turu olmadığı için toplama katılmamıştır.`}
              </p>
              <table>
                <thead>
                  <tr><th scope="col">Para birimi</th><th scope="col">Haber</th><th scope="col">Toplam</th></tr>
                </thead>
                <tbody>
                  {o.tutarlar.map((t) => (
                    <tr><td>{t.paraBirimi}</td><td>{formatNumber(t.adet)}</td><td>{formatMoneyShort(t.toplam, t.paraBirimi)}</td></tr>
                  ))}
                </tbody>
              </table>
            </>
          )}

          {o.turlar.length > 0 && (
            <>
              <h2>Yatırım turları</h2>
              <table>
                <thead>
                  <tr><th scope="col">Tur</th><th scope="col">Haber</th></tr>
                </thead>
                <tbody>
                  {o.turlar.map((t) => (
                    <tr><td>{t.tur}</td><td>{formatNumber(t.adet)}</td></tr>
                  ))}
                </tbody>
              </table>
            </>
          )}

          {o.enBuyukler.length > 0 && (
            <>
              <h2>En büyük tutarlar</h2>
              <p>Her para biriminde en büyük beş girişim turu.</p>
              <ul>
                {o.enBuyukler.map((e) => (
                  <li><a href={`/haber/${e.id}/`}>{e.title}</a>: {formatMoneyShort(e.toplanan, e.paraBirimi)}</li>
                ))}
              </ul>
            </>
          )}

          <h2>Kitle fonlama kampanyaları</h2>
          {o.kampanya.kayitGunu > 0 ? (
            <>
              <p>
                Çeyrekte {formatNumber(o.kampanya.kayitGunu)} günlük kayıt alındı; kayıtlarda {formatNumber(o.kampanya.kampanyaSayisi)}{' '}
                kampanya yer aldı, bunların {formatNumber(o.kampanya.hedefeUlasan)} tanesi çeyrekteki son kaydında hedefine ulaşmıştı.
              </p>
              <table>
                <thead>
                  <tr><th scope="col">Platform</th><th scope="col">Kampanya</th><th scope="col">Toplanan (son kayıt)</th></tr>
                </thead>
                <tbody>
                  {o.kampanya.platformlar.map((p) => (
                    <tr><td><a href={platformUrl(p.platform)}>{p.platform}</a></td><td>{formatNumber(p.kampanya)}</td><td>{formatMoneyShort(p.toplam, 'TRY')}</td></tr>
                  ))}
                </tbody>
              </table>
            </>
          ) : (
            <p>Bu çeyrekte kampanya kaydı yok.</p>
          )}

          <h2>Raporu kullanın</h2>
          <p>
            Rakamları alıntılayabilir, görseli ve tabloları paylaşabilirsiniz; kaynak olarak bu sayfayı gösterin:
          </p>
          <p><strong>{kaynak}</strong></p>
          <figure>
            <img src={gorsel} alt={raporKartAlt(o)} width={KAPAK_G} height={KAPAK_Y} loading="lazy" decoding="async" />
          </figure>
          <ul>
            <li><a href={csv} download>Bütün tablolar (CSV)</a></li>
            <li><a href={gorsel} download>Özet görseli (PNG, 1200×675)</a></li>
          </ul>
          <p>Sitenize ya da bülteninize eklemek için gömme kodu:</p>
          <pre class="gomme-kodu"><code>{gomme}</code></pre>

          <h2>Yöntem</h2>
          <ul>
            <li>Haber sayıları arama motorlarına açık haberleri kapsar; bülten yazıları, kısa ve kapsam dışı haberler sayılmaz.</li>
            <li>Yatırım tutarları haberlerin künyesindeki tutardır; aynı olayın tekrar yazılmaması için mükerrer haberler yayından önce elenir.</li>
            <li>Tur adları gruplanır (ör. “Ön tohum” ve “Tohum öncesi” tek satırdır); yalnız bir haberde geçen turlar “Diğer” satırındadır.</li>
            <li>Kampanya rakamları her gün 18:00’de platformların kampanya sayfalarından alınan kayıtlardır; platform toplamı her kampanyanın çeyrekteki son kaydının toplamıdır.</li>
            <li>Rapor, çeyrek bittikten sonra ve çeyrekte en az {EN_AZ_RAPOR_HABERI} haber varsa yayımlanır.</li>
          </ul>
          <p>{RISK_NOTU}</p>
        </div>
      </article>
    )
  }
</Base>

<style>
  .gomme-kodu {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    background: var(--kagit-2);
    border: 1px solid var(--cizgi);
    font-size: 0.8rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    user-select: all;
  }
  figure {
    margin: 0 0 1rem;
  }
</style>
