---
import Base from '../layouts/Base.astro';
import { getNews, newsUrl } from '../lib/news';
import { duzeltmeKayitlari, tarihYazi, type KaldirilanKayit } from '../lib/duzeltmeler';
import kaldirilanVeri from '../data/duzeltmeler-kaldirilan.json';

const haberler = await getNews();
const kayitlar = duzeltmeKayitlari(
  haberler.map((h) => ({
    baslik: h.data.title,
    href: newsUrl(h),
    duzeltme: h.data.duzeltme,
    yedekTarih: (h.data.updated ?? h.data.date).toISOString().slice(0, 10),
  })),
  kaldirilanVeri as KaldirilanKayit[],
);
---

<Base
  title="Düzeltmeler"
  description="kifobu'da yapılan düzeltmeler, güncellemeler ve yayından kaldırılan haberler."
>
  <article class="makale">
    <header class="makale-bas">
      <h1>Düzeltmeler</h1>
    </header>
    <div class="metin">
      <p>
        Bir haberde hata yaparsak düzeltir, bir haberi kaldırırsak nedenini söyleriz. Her değişikliği tarihiyle bu sayfada
        açıkça yazarız.
      </p>
      <p>
        Nasıl çalıştığımız için <a href="/duzeltme-politikasi/">Düzeltme Politikası</a> sayfamıza bakın. Bir hata
        görürseniz her haberin sonundaki "Hata bildir" bağlantısını kullanabilirsiniz.
      </p>

      {kayitlar.length === 0 && <p>Henüz kayıt yok.</p>}
      {
        kayitlar.length > 0 && (
          <ul class="duzeltme-kayitlari">
            {kayitlar.map((k) => (
              <li>
                <strong>{tarihYazi(k.tarih)} · {k.tur}</strong>
                {k.baslik && <Fragment> · {k.href ? <a href={k.href}>{k.baslik}</a> : k.baslik}</Fragment>}
                : {k.metin}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </article>
</Base>
