---
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HaberSatiri from '../../components/HaberSatiri.astro';
import Kunye from '../../components/Kunye.astro';
import Isaret from '../../components/Isaret.astro';
import Yol from '../../components/Yol.astro';
import { SITE, YAZAR, yazarLd, yazarUrl, kisiYazariMi, DURUMLAR, kunyeNotu, categoryName, formatDate, formatMoney, formatNumber, percentOf, type Durum } from '../../lib/site';
import { getNews, isFunding, type Haber } from '../../lib/news';
import { indekslenir } from '../../lib/indeks';
import { ilgiliHaberler } from '../../lib/ilgili';
import { dizinVerisi, haberBaglantilari } from '../../lib/dizin';
import { gunUrl, istanbulGunu } from '../../lib/gunler';
import { matchEntities } from '../../lib/entities';
import { duzeltmeNotu } from '../../lib/duzeltme';
import { analizMi, bolumAdlari } from '../../lib/yazi-turu';
import { yapayZekaNotu } from '../../lib/yapay-zeka-notu';
import NasilHazirlandi from '../../components/NasilHazirlandi.astro';
import { kaynakSatiri } from '../../lib/kaynak-satiri';
import { ICERIK_LISANSI } from '../../lib/icerik-lisansi';
import { kapakAlt, kapakUrl, KAPAK_G, KAPAK_Y, LOGO_G, LOGO_Y } from '../../kapak/ciz';
import '../../styles/graf.css';
import '../../styles/haber.css';
import AracSatiri from '../../components/haber/AracSatiri.astro';
import Kisaca from '../../components/haber/Kisaca.astro';
import Nasil from '../../components/haber/Nasil.astro';
import DahaOnce from '../../components/haber/DahaOnce.astro';
import Degisiklikler from '../../components/haber/Degisiklikler.astro';
import Fayda from '../../components/haber/Fayda.astro';
import YerHaritasi from '../../components/haber/YerHaritasi.astro';
import Kaynaklar from '../../components/haber/Kaynaklar.astro';
import { haberKaynaklari } from '../../lib/kaynaklar.mjs';
import { dahaOnce } from '../../lib/daha-once';
import { adimlar } from '../../lib/hazirlanis.mjs';
import { haberinIli } from '../../lib/yer.mjs';

export async function getStaticPaths() {
  const news = await getNews();
  const veri = await dizinVerisi();
  const gunler = new Set(veri.gunler.map((g) => g.tarih));
  return news.map((haber) => {
    const gun = istanbulGunu(haber.data.date);
    return {
      params: { id: haber.id },
      // İlgili haberler: ortak girişim/platform/yatırımcı, yoksa aynı bölüm; bülten ve noindex haberler hariç (src/lib/ilgili.ts).
      // Konular: sayfası üretilmiş kampanya, platform ve konu bağlantıları (src/lib/dizin.ts); günün bülten sayfası.
      // Daha önce bu konuda: aynı girişim, platform ya da ortak özel ad ve anlam benzerliği (src/lib/daha-once.ts).
      props: { haber, related: ilgiliHaberler(haber, news, 3), konular: haberBaglantilari(haber, veri), bultenGunu: gunler.has(gun) ? gun : undefined, onceki: dahaOnce(haber, news) },
    };
  });
}

interface Props {
  haber: Haber;
  related: Haber[];
  konular: { ad: string; url: string }[];
  bultenGunu?: string;
  onceki: Haber[];
}

const { haber, related, konular, bultenGunu, onceki } = Astro.props;
const d = haber.data;
const duzeltme = duzeltmeNotu(d, 'tr');
const yzNotu = yapayZekaNotu(d, d.title, new URL(Astro.url.pathname, Astro.site).href);
const { title, description, date, category, cover, coverAlt } = d;
const { Content } = await render(haber);
// Kaynaklar adıyla (src/lib/kaynaklar.mjs; adlar derlemede şifreli izden çözülür). Çözülemezse eski adsız satır.
const kaynaklar = haberKaynaklari(d);
const kaynak = kaynaklar.length ? undefined : kaynakSatiri(d);
const funding = isFunding(haber);
// Kapsam dışı ya da 120 kelimeden kısa haber: sayfa kalır, arama motorlarına kapalıdır (noindex, follow).
const noindex = !indekslenir({ draft: d.draft, noindex: d.noindex, govde: haber.body });
const pct = percentOf(d.toplanan, d.hedef);
// "Bu haber nasıl hazırlandı" kartı (bot haberi ve sahibin yazısı); kart çıkmayan yazı eski tek satırlık notu korur.
const kart = (adimlar(d)?.length ?? 0) > 0;
// Yer haritası: Türkiye'deki girişimin haberi ve metinde "<İl> merkezli" (src/lib/yer.mjs).
const il = haberinIli({ girisim: d.girisim, uretim: d.uretim, govde: haber.body });
const kelime = (haber.body ?? '').split(/\s+/).filter(Boolean).length;
const okumaDk = kelime > 0 ? Math.max(1, Math.round(kelime / 200)) : 0;

// Kapak resmi yoksa haberin künyesinden çizilen kapak (1200×675) kullanılır (paylaşım görseli dahil).
// Her haberin kapağı her derlemede çizilir (dosya bütçesi: src/lib/news.ts).
const coverImg = cover ? await getImage({ src: cover, width: 1200, format: 'jpeg' }) : undefined;
const ogImage = coverImg ? coverImg.src : kapakUrl(haber);
const ogW = coverImg ? Number(coverImg.attributes.width) || 1200 : KAPAK_G;
const ogH = coverImg ? Number(coverImg.attributes.height) || 630 : KAPAK_Y;
const ogAlt = cover ? (coverAlt ?? title) : kapakAlt(haber);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const siteUrl = new URL('/', Astro.site).href;
const orgRef = { '@id': `${siteUrl}#organization` };
const categoryUrl = new URL(`/${category}/`, Astro.site).href;
const headline = title.length > 110 ? `${title.slice(0, 109).trimEnd()}…` : title;
const isoDate = date.toISOString();
// Değişiklik tarihi: ön bilgideki updated (içerik düzeltildiyse), yoksa yayın tarihi.
const isoModified = (d.updated && d.updated > date ? d.updated : date).toISOString();

const entities = matchEntities(`${title} ${description} ${haber.body ?? ''}`);

const articleSchema: Record<string, any> = {
  '@type': analizMi(haber.data) ? 'AnalysisNewsArticle' : 'NewsArticle',
  '@id': `${pageUrl}#article`,
  headline,
  description,
  datePublished: isoDate,
  dateModified: isoModified,
  // Analiz ve köşe yazılarında kişi imzası; diğer tüm haberlerde yayıncı kuruluş gösterilir.
  author: kisiYazariMi(haber.data) ? yazarLd(Astro.site!) : orgRef,
  // Yayıncının tek tanımı Base.astro'daki Organization düğümünde; aynı @id ile çelişen ikinci logo yazılmaz.
  publisher: orgRef,

  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  url: pageUrl,
  articleSection: bolumAdlari(categoryName(category), haber.data),
  inLanguage: 'tr-TR',
  license: ICERIK_LISANSI.url,
  isAccessibleForFree: true,
  isPartOf: { '@id': `${siteUrl}#website` },
  image: [
    {
      '@type': 'ImageObject',
      url: new URL(ogImage, Astro.site).href,
      width: ogW,
      height: ogH,
    },
  ],
};

if (entities.length > 0) {
  articleSchema.about = entities;
}
// Yararlanılan haberler (yalın atıf; adlar derlemede çözülür).
if (kaynaklar.length) articleSchema.isBasedOn = kaynaklar.map((k) => ({ '@type': 'NewsArticle', url: k.url, publisher: { '@type': 'Organization', name: k.ad } }));
// Haberin geçtiği yer (yer haritası çıkan haberlerde).
if (il) articleSchema.contentLocation = { '@type': 'Place', name: il, address: { '@type': 'PostalAddress', addressLocality: il, addressCountry: 'TR' } };

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    articleSchema,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: categoryName(category), item: categoryUrl },
        { '@type': 'ListItem', position: 3, name: headline, item: pageUrl },
      ],
    },
  ],
};
---

<Base title={title} description={description} image={ogImage} imageWidth={ogW} imageHeight={ogH} imageAlt={ogAlt} type="article" noindex={noindex}>
  <Fragment slot="head">
    <meta name="author" content={kisiYazariMi(haber.data) ? YAZAR.ad : SITE.name} />
    {kisiYazariMi(haber.data) && <meta property="article:author" content={yazarUrl(Astro.site!)} />}
    <meta property="article:published_time" content={isoDate} />
    <meta property="article:modified_time" content={isoModified} />
    <meta property="article:section" content={categoryName(category)} />
    <script type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  </Fragment>

  <div class="yh-ilerleme" aria-hidden="true"><span></span></div>
  <article class="makale">
    <Yol adimlar={[{ ad: 'Anasayfa', url: '/' }, { ad: categoryName(category), url: `/${category}/` }, { ad: title }]} />
    <header class="makale-bas yh-bas">
      <p class="yh-ust">
        <a href={`/${category}/`}>{categoryName(category)}</a>
        {analizMi(haber.data) && <span class="ek">Analiz</span>}
        {d.tur && funding && <span class="ek">{d.tur}</span>}
        {duzeltme && <a class="duzeltildi" href="#degisiklikler">Düzeltildi</a>}
      </p>
      <h1>{title}</h1>
      <p class="makale-spot yh-spot">{description}</p>
      <p class="yh-imza">
        <span>
          Yazan {kisiYazariMi(haber.data) ? <a href={YAZAR.yol} rel="author"><b>{YAZAR.ad}</b></a> : d.uretim === 'yapay-zeka' ? <><b>{SITE.name} yapay zekâ masası</b> <span class="yz">YZ</span></> : <b>{SITE.name}</b>}
        </span>
        <span><time datetime={isoDate}>{formatDate(date, true)}</time></span>
        {d.updated && d.updated > date && <span>Güncellendi <time datetime={isoModified}>{formatDate(d.updated, true)}</time></span>}
        {okumaDk > 0 && <span>{okumaDk} dk okuma</span>}
        {il && <span>◉ {il}</span>}
      </p>
      {/* Medya kaynaklı bot haberinde adsız kaynak satırı (src/lib/kaynak-satiri.ts). */}
      {
        kaynaklar.length > 0 && (
          <p class="yh-kaynak">
            {kaynaklar.length === 1 ? 'Kaynak' : 'Kaynaklar'}:{' '}
            {/* Tek satırda: satır sonları virgülden önce boşluk bırakıyordu. */}
            {kaynaklar.map((k, i) => <>{i > 0 && ', '}<a href={k.url} rel="nofollow noopener" target="_blank">{k.ad}</a></>)}
          </p>
        )
      }
      {kaynak && <p class="yh-kaynak">{kaynak}</p>}
      <AracSatiri url={pageUrl} baslik={title} />
    </header>

    <Kisaca whyMatters={d.why_matters} keyPoints={d.key_points} />

    {/* Künye haberin başında (sentezin altında, görselin üstünde): okur önce rakamları görür. */}
    {
      funding && (
        <section class="kampanya-kunyesi tahta-zemin" aria-label="Kampanya künyesi">
          <dl>
            <div class="kk-girisim">
              <dt>Girişim</dt>
              <dd>{d.girisim}</dd>
            </div>
            {d.platform && (
              <div>
                <dt>Platform</dt>
                <dd class="kk-platform">{d.platform}</dd>
              </div>
            )}
            <div class="kk-toplanan">
              <dt>Toplanan</dt>
              <dd class="tk-toplanan">{formatMoney(d.toplanan!, d.paraBirimi)}</dd>
            </div>
            {d.tur && (
              <div>
                <dt>Tur</dt>
                <dd>{d.tur}</dd>
              </div>
            )}
            {d.yatirimcilar && (
              <div class="kk-genis">
                <dt>Yatırımcılar</dt>
                <dd class="kk-yatirimcilar">{d.yatirimcilar}</dd>
              </div>
            )}
            {d.hedef && (
              <div>
                <dt>Hedef</dt>
                <dd>{formatMoney(d.hedef, d.paraBirimi)}</dd>
              </div>
            )}
            {pct !== undefined && (
              <div>
                <dt>Gerçekleşme</dt>
                <dd>{pct}</dd>
              </div>
            )}
            {d.yatirimci !== undefined && (
              <div>
                <dt>Yatırımcı</dt>
                <dd>{formatNumber(d.yatirimci)}</dd>
              </div>
            )}
            {d.durum && (
              <div class="kk-durum">
                <dt>Durum</dt>
                <dd>
                  <Isaret durum={d.durum} size={20} /> {DURUMLAR[d.durum as Durum]}
                </dd>
              </div>
            )}
          </dl>
          <p class="kk-risk">{kunyeNotu(d)}</p>
        </section>
      )
    }

    {/* Künyeden çizilen kapak sayfada gösterilmez: başlığı bir kez daha tekrar ediyordu (paylaşım görseli olarak kalır,
        tidsrøst ile aynı karar). Yüklenmiş gerçek kapak resmi gösterilir. */}
    {
      cover && (
        <figure class="makale-gorsel">
          <Image src={cover} alt={coverAlt ?? title} width={1200} loading="eager" fetchpriority="high" decoding="async" />
          {coverAlt && <figcaption>{coverAlt}</figcaption>}
        </figure>
      )
    }

    <div class="metin yh-metin">
      <Content />
    </div>

    {il && <YerHaritasi il={il} />}

    <Degisiklikler duzeltme={duzeltme?.metin} degisti={d.updated && d.updated > date ? d.updated : undefined} />

    <DahaOnce haberler={onceki} baslik={title} tarih={date} />

    <Kaynaklar kaynaklar={kaynaklar} />

    {/* Standartlar: gövdeden sonra yapay zekâ notu. Bot haberi ve sahibin yazısı "Bu haber nasıl hazırlandı" kartını
        alır (src/lib/hazirlanis.mjs); öteki yazılar (günlük bülten, zincir) tek satırlık notu korur. */}
    {kart && <Nasil haber={{ ...d, kaynakSayisi: kaynaklar.length }} kaynakSayisi={kaynaklar.length} baslik={title} url={pageUrl} yayin={date} degisti={d.updated && d.updated > date ? d.updated : undefined} duzeltildi={Boolean(duzeltme)} />}
    {
      !kart && yzNotu &&
        (yzNotu.satirlar ? (
          <NasilHazirlandi satirlar={yzNotu.satirlar} mailto={yzNotu.mailto} baglantiMetni={yzNotu.baglantiMetni} />
        ) : (
          <p class="yz-notu" data-yz={yzNotu.tur}>
            {yzNotu.metin} <a href={yzNotu.mailto}>{yzNotu.baglantiMetni}</a>
          </p>
        ))
    }

    {
      (konular.length > 0 || bultenGunu) && (
        <nav class="etiketler" aria-label="Konular">
          <span>Konular</span>
          {konular.map((k) => (
            <a href={k.url}>{k.ad}</a>
          ))}
          {bultenGunu && <a href={gunUrl(bultenGunu)}>{formatDate(new Date(`${bultenGunu}T12:00:00+03:00`))} bülteni</a>}
        </nav>
      )
    }

    <Fayda slug={haber.id} />

    <footer class="makale-son">
      <Kunye haber={haber} withTime />
    </footer>
  </article>

  {
    related.length > 0 && (
      <section class="bolum" aria-labelledby="ilgili">
        <div class="bolum-bas">
          <h2 class="bolum-baslik" id="ilgili">
            İlgili haberler
          </h2>
          <a href={`/${category}/`}>{categoryName(category)}: tümü</a>
        </div>
        <div class="satir-izgara">
          {related.map((h) => (
            <HaberSatiri haber={h} showCategory={false} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<script>
  // Yazılardaki grafik kartları (src/lib/graf/yazi.mjs): dokununca ve üzerine gelince değer.
  import '../../scripts/graf.mjs';
</script>
