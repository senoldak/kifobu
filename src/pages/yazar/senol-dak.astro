---
// Yazar sayfası: sitedeki bütün yazıların görünen yazarı. Biyografi uydurulmaz; yalnız ad, unvan, nötr tek cümle,
// iletişim e-postası ve son yazılar yer alır.
import Base from '../../layouts/Base.astro';
import HaberSatiri from '../../components/HaberSatiri.astro';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { SITE, YAZAR, yazarLd, yazarUrl } from '../../lib/site';
import { getNews, newsUrl } from '../../lib/news';

const haberler = await getNews();
const sayfaUrl = yazarUrl(Astro.site!);
const siteUrl = new URL('/', Astro.site).href;
const aciklama = `${YAZAR.ad}, ${SITE.name} yayınının ${YAZAR.unvan.toLocaleLowerCase('tr-TR')}dir. Sitedeki yazılar bu adla yayımlanır. İletişim: ${YAZAR.epost}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${sayfaUrl}#page`,
      url: sayfaUrl,
      name: YAZAR.ad,
      description: aciklama,
      inLanguage: 'tr-TR',
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { ...yazarLd(Astro.site!), description: aciklama, email: YAZAR.epost },
      hasPart: haberler.slice(0, 50).map((h) => ({
        '@type': 'NewsArticle',
        url: new URL(newsUrl(h), Astro.site).href,
        headline: h.data.title,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: YAZAR.ad, item: sayfaUrl },
      ],
    },
  ],
};
---

<Base title={`${YAZAR.ad}: ${YAZAR.unvan}`} description={aciklama}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <article class="makale">
    <header class="makale-bas">
      <h1>{YAZAR.ad}</h1>
      <p class="makale-spot">{YAZAR.unvan}</p>
    </header>
    <div class="metin">
      <p>
        {YAZAR.ad}, {SITE.name} yayınının {YAZAR.unvan.toLocaleLowerCase('tr-TR')}dir. Sitedeki yazılar bu adla yayımlanır; yapay zekâ
        kullanımı her yazının sonundaki nottan ve <a href="/yapay-zeka-kullanimi/">Yapay Zekâ Kullanımı</a> sayfasından okunabilir.
      </p>
      <p>İletişim: <a href={`mailto:${YAZAR.epost}`}>{YAZAR.epost}</a></p>
    </div>
  </article>
  <section class="bolum" aria-labelledby="son-yazilar">
    <div class="bolum-bas">
      <h2 class="bolum-baslik" id="son-yazilar">Son yazılar</h2>
    </div>
    <div class="satir-izgara">
      {haberler.slice(0, 30).map((h) => <HaberSatiri haber={h} />)}
    </div>
  </section>
</Base>
