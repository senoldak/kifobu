---
// Yazar sayfası ("portre bandı"): kâğıt bantta fotoğraf, ad ve künye; altında GitHub katkı ızgarası gibi dört siteli gün ızgarası;
// sonra kifobu'daki imzalı yazılar ay ay, iki sütunlu dizin. Yalnız kişi imzalı yazılar (kisiYazariMi) listelenir. Biyografi uydurulmaz.
import Base from '../../layouts/Base.astro';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { SITE, YAZAR, yazarLd, yazarUrl, kisiYazariMi, categoryName, formatDate } from '../../lib/site';
import { getNews, newsUrl, type Haber } from '../../lib/news';
import { kunyeParcalari } from '../../lib/kunye.mjs';
import { aarsRutenett } from '../../lib/aktivitet.mjs';
import yazarAktivite from '../../data/yazar-aktivite.json';

const haberler: Haber[] = (await getNews()).filter((h) => kisiYazariMi(h.data));
const sayfaUrl = yazarUrl(Astro.site!);
const siteUrl = new URL('/', Astro.site).href;
const aciklama = YAZAR.kunye[0];
const ROL = 'Gazeteci · öğretmen · üretken yapay zekâ sistemleri · veri analizi ve araştırma';
const FOTO = '/yazar-foto/senol-dak.jpg';

const turAdi = (h: Haber) =>
  h.data.yaziTuru === 'analiz' ? 'Analiz' : h.data.yaziTuru === 'aciklayici' ? 'Açıklayıcı' : h.data.yaziTuru === 'referans' ? 'Referans' : categoryName(h.data.category);

const ayFmt = new Intl.DateTimeFormat('tr-TR', { month: 'long', year: 'numeric', timeZone: 'Europe/Istanbul' });
const ayKisa = new Intl.DateTimeFormat('tr-TR', { month: 'short', timeZone: 'UTC' });
const gunUzun = new Intl.DateTimeFormat('tr-TR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const utc = (key: string) => new Date(`${key}T12:00:00Z`);

const perAy: [string, Haber[]][] = [];
for (const h of haberler) {
  const k = ayFmt.format(h.data.date);
  const son = perAy.at(-1);
  if (son && son[0] === k) son[1].push(h);
  else perAy.push([k, [h]]);
}

// Dört sitenin imzalı yazıları (her sitenin kendi listesinden derlenir). Her site kendi renginde; kare dörde bölünür.
const SIDER = [
  { id: 'tidsrost', ad: 'tidsrøst' },
  { id: 'jendume', ad: 'jenDume' },
  { id: 'finfolis', ad: 'finfolis' },
  { id: 'kifobu', ad: 'kifobu' },
];
// Bu sitenin yazıları içerikten; diğer üç site derlemede çekilen listeden (scripts/yazar-aktivite.mjs, prebuild).
const egne = haberler.map((h) => ({ site: 'kifobu', date: h.data.date.toISOString() }));
const andre = Object.entries((yazarAktivite as { sider: Record<string, string[]> }).sider ?? {})
  .filter(([site]) => site !== 'kifobu')
  .flatMap(([site, tarihler]) => tarihler.map((date) => ({ site, date })))
  .filter((x) => new Date(x.date) <= new Date());
const poster = [...egne, ...andre];
// 10.08.2022 – 13.10.2026: gün gün kayıt yok; bu günler aynı kutularla, açık tonda gösterilir. Kayıtlı günler tam renkte.
// Sahibinin kararıyla sayfada bu dönemle ilgili hiçbir not yoktur.
const EGEN = { fra: '2022-08-10', til: '2026-10-13', sider: ['jendume', 'finfolis', 'kifobu'] };
const yilSatirlari = aarsRutenett(poster, EGEN);
// Bu dönemde her gün aynı üç site dolu; yalnız parçaların yeri tarihe bağlı karışır (dama deseni olmasın).
// Derleme her seferinde aynı sonucu verir.
function blandet(key: string): (string | null)[] {
  let t = 2166136261;
  for (const ch of key) t = Math.imul(t ^ ch.charCodeAt(0), 16777619);
  const ruter: (string | null)[] = [...EGEN.sider, null];
  for (let i = ruter.length - 1; i > 0; i--) {
    t = Math.imul(t ^ (t >>> 15), 2246822507) >>> 0;
    const j = t % (i + 1);
    [ruter[i], ruter[j]] = [ruter[j], ruter[i]];
  }
  return ruter;
}
// Yıl iki yarıya bölünür (ocak–haziran, temmuz–aralık): geniş ekranda yan yana tek satır, dar ekranda alt alta.
type Satir = ReturnType<typeof aarsRutenett>[number];
function yarilar(r: Satir) {
  const i = r.uker.findIndex((u) => (u.find(Boolean)?.key.slice(5, 7) ?? '00') >= '07');
  const kes = i <= 0 ? (i === 0 ? 0 : r.uker.length) : i;
  return [
    { uker: r.uker.slice(0, kes), aylar: r.maaneder.filter((m) => m.kol < kes) },
    { uker: r.uker.slice(kes), aylar: r.maaneder.filter((m) => m.kol >= kes).map((m) => ({ ...m, kol: m.kol - kes })) },
  ].filter((h) => h.uker.length > 0);
}
const stor = (s: string) => s.charAt(0).toLocaleUpperCase('tr-TR') + s.slice(1);
const ayAdi = (ay: string) => stor(ayKisa.format(utc(`${ay}-15`))).replace('.', '');
// Ay etiketi: her hafta sütununa bir hücre, ayın ilk haftasında ad (satır içi grid-column yok, CSP).
const ayEtiketi = (h: { aylar: { kol: number; mnd: string }[] }, kol: number) => {
  const m = h.aylar.find((x) => x.kol === kol);
  return m ? ayAdi(m.mnd) : '';
};
const hucreBaslik = (c: { key: string; siter: string[] }) =>
  `${gunUzun.format(utc(c.key))}${c.siter.length ? `: ${SIDER.filter((x) => c.siter.includes(x.id)).map((x) => x.ad).join(', ')}` : ''}`;
const enYeni = yilSatirlari[0]?.aar;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${sayfaUrl}#page`,
      url: sayfaUrl,
      name: YAZAR.ad,
      description: aciklama,
      inLanguage: 'tr-TR',
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { ...yazarLd(Astro.site!), description: aciklama, email: YAZAR.epost, image: new URL(FOTO, Astro.site).href },
      hasPart: haberler.slice(0, 50).map((h) => ({
        '@type': 'NewsArticle',
        url: new URL(newsUrl(h), Astro.site).href,
        headline: h.data.title,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: YAZAR.ad, item: sayfaUrl },
      ],
    },
  ],
};
---

<Base title={`${YAZAR.ad}: ${YAZAR.unvan}`} description={aciklama}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />

  <section class="fp-band" aria-labelledby="fp-ad">
    <div class="fp-in">
      <img class="fp-foto" src={FOTO} width="360" height="360" alt={`${YAZAR.ad} portresi`} />
      <div class="fp-tekst">
        <h1 class="fp-ad" id="fp-ad">{YAZAR.ad}</h1>
        <p class="fp-rol">{ROL}</p>
        <div class="fp-bio">
          {
            YAZAR.kunye.map((p, i) => (
              <p class={i === 0 ? 'fp-ingress' : undefined}>{kunyeParcalari(p).map((x) => (x.adres ? <a href={x.adres}>{x.metin}</a> : x.metin))}</p>
            ))
          }
        </div>
        <a class="fp-epost" href={`mailto:${YAZAR.epost}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.61 9.17a.25.25 0 0 1 .39.21v9.37a.25.25 0 0 1-.25.25H3.25a.25.25 0 0 1-.25-.25V9.38a.25.25 0 0 1 .39-.21l8.47 5.49a.25.25 0 0 0 .28 0l8.47-5.49Z"></path>
            <path d="M20.75 5a.25.25 0 0 1 .25.25v.78a.25.25 0 0 1-.11.21l-8.75 5.67a.25.25 0 0 1-.28 0L3.11 6.24A.25.25 0 0 1 3 6.03v-.78A.25.25 0 0 1 3.25 5h17.5Z"></path>
          </svg>
          Şenol'a e-posta gönder
        </a>
      </div>
    </div>
  </section>

  {
    yilSatirlari.length > 0 && (
      <section class="fp-akt" aria-labelledby="fp-akt-baslik">
        <h2 class="fp-baslik" id="fp-akt-baslik">Dört sitede yayımlanan yazılar</h2>
        {/* Yıl seçimi GitHub gibi: düğmeye basınca o yıl açılır, varsayılan en yeni yıl. JS yok; radyo + :has. */}
        <fieldset class="fp-yil-sec">
          <legend class="sr-only">Yıl seçin</legend>
          {[...yilSatirlari].reverse().map((r) => (
            <label>
              <input type="radio" name="fp-yil" value={String(r.aar)} checked={r.aar === enYeni} />
              <span>{r.aar}</span>
            </label>
          ))}
        </fieldset>
        {/* CSP style-src 'self': satır içi stil yok. Yıl satırları düğmelerle aynı sırada; eşleşme nth-of-type ile (CSS'te). */}
        <div class="fp-yillar" role="img" aria-label="tidsrøst, jenDume, finfolis ve kifobu'da yayımlanan yazıların yıllara göre gün ızgarası.">
          {[...yilSatirlari].reverse().map((r) => (
            <div class="fp-yil" aria-hidden="true">
              <span class="fp-yil-no">{r.aar}</span>
              <div class="fp-yil-cerceve">
                {yarilar(r).map((h) => (
                  <div class="fp-yari">
                    <div class="fp-ay-satiri">{h.uker.map((_, kol) => <span>{ayEtiketi(h, kol)}</span>)}</div>
                    <div class="fp-gunler">
                      {h.uker.map((uke) =>
                        uke.map((c) =>
                          !c ? (
                            <span class="d x" />
                          ) : c.fremtid ? (
                            <span class="d f" />
                          ) : c.egen ? (
                            <span class="d h e">{blandet(c.key).map((id) => <i class={id ? `s-${id}` : undefined} />)}</span>
                          ) : c.siter.length ? (
                            <span class="d h" title={hucreBaslik(c)}>
                              {SIDER.map((x) => <i class={c.siter.includes(x.id) ? `s-${x.id}` : undefined} />)}
                            </span>
                          ) : (
                            <span class="d" title={hucreBaslik(c)} />
                          ),
                        ),
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <ul class="fp-siteler">
          {SIDER.map((x, i) => (
            <li>
              <span class="fp-mini" aria-hidden="true">{SIDER.map((y, j) => <i class={j === i ? `s-${y.id}` : undefined} />)}</span>
              {x.ad}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="fp-liste" aria-label={`${SITE.name} yazıları`}>
    {
      perAy.map(([ay, liste]) => (
        <section class="fp-ay">
          <h2 class="fp-baslik">{ay}</h2>
          <div class="fp-izgara">
            {liste.map((h) => (
              <article class="fp-yazi">
                <h3>
                  <a href={newsUrl(h)}>{h.data.title}</a>
                </h3>
                <p class="fp-ozet">{h.data.description}</p>
                <p class="fp-meta">
                  <span class="fp-tur">{turAdi(h)}</span>
                  <time datetime={h.data.date.toISOString()}>{formatDate(h.data.date)}</time>
                </p>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </section>
</Base>

<style>
  /* Portre bandı: kifobu kâğıdında bir kademe koyu zemin, üstte kalın mürekkep çizgisi (bölüm başlıklarıyla aynı), düz, gölgesiz. */
  .fp-band {
    background: var(--kagit-2);
    border-top: 6px solid var(--murekkep);
    border-bottom: 1px solid var(--cizgi);
    margin: 32px calc(-1 * var(--kenar)) 0;
  }
  .fp-in {
    display: grid;
    grid-template-columns: minmax(200px, 360px) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    padding: 0 var(--kenar);
    max-width: 1280px;
    margin: 0 auto;
  }
  /* Fotoğraf kendi kare oranında, en fazla 360 px; bandın yüksekliğine gerilmez. */
  .fp-foto {
    display: block;
    width: 100%;
    max-width: 360px;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    align-self: start;
    margin: clamp(32px, 5vw, 56px) 0;
    border: 1.5px solid var(--murekkep);
  }
  .fp-tekst {
    align-self: center;
    padding: clamp(32px, 5vw, 56px) 0;
  }
  .fp-ad {
    margin: 0 0 14px;
    font-family: var(--yazi-baslik);
    font-weight: 700;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .fp-rol {
    margin: 0 0 28px;
    padding-bottom: 14px;
    border-bottom: 3px solid var(--marka-sari);
    display: inline-block;
    max-width: 100%;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--murekkep-2);
  }
  .fp-bio p {
    margin: 0 0 16px;
    max-width: 62ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--murekkep-2);
  }
  .fp-bio .fp-ingress {
    font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
    line-height: 1.5;
    color: var(--murekkep);
  }
  .fp-bio a {
    color: var(--murekkep);
    text-decoration: underline;
    text-decoration-color: var(--marka-sari);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .fp-epost {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    margin-top: 8px;
    padding: 0 22px;
    background: var(--murekkep);
    color: var(--kagit);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    transition: background-color 160ms var(--gecis), color 160ms var(--gecis);
  }
  .fp-epost:hover {
    background: var(--marka-sari);
    color: var(--murekkep);
  }

  /* Bölüm başlığı: ince büyük harfli etiket, altında kalın mürekkep çizgi (sitenin .bolum-bas diliyle). */
  .fp-baslik {
    margin: 0 0 22px;
    padding-top: 12px;
    border-top: 6px solid var(--murekkep);
    font-family: var(--yazi-baslik);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Gün ızgarası. Site renkleri: tidsrøst sol üst, jenDume sağ üst, finfolis sol alt, kifobu sağ alt. */
  .fp-akt {
    --c-tidsrost: #1f5f99;
    --c-jendume: #00924a;
    --c-finfolis: #c2502b;
    --c-kifobu: #e8b40c;
    --rute: 16px;
    --rom: 3px;
    --bos: color-mix(in srgb, var(--murekkep) 6%, var(--kagit));
    margin-top: 56px;
  }
  .fp-yil-sec {
    display: flex;
    flex-wrap: wrap;
    margin: 0 0 24px;
    padding: 0;
    border: 0;
  }
  .fp-yil-sec label {
    position: relative;
    cursor: pointer;
  }
  .fp-yil-sec input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .fp-yil-sec span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--gri);
    box-shadow: inset 0 -1px 0 var(--cizgi);
    transition: color 160ms var(--gecis), box-shadow 160ms var(--gecis);
  }
  .fp-yil-sec label:hover span {
    color: var(--murekkep);
    box-shadow: inset 0 -3px 0 var(--cizgi);
  }
  .fp-yil-sec input:checked + span {
    color: var(--murekkep);
    box-shadow: inset 0 -3px 0 var(--marka-sari);
  }
  .fp-yil-sec input:focus-visible + span {
    outline: 2px solid var(--murekkep);
    outline-offset: -2px;
  }
  /* Yıl seçimi: düğme k seçiliyse k. yıl satırı görünür (en fazla 12 yıl; satır içi stil yok, CSP). */
  @supports selector(:has(*)) {
    .fp-yillar .fp-yil {
      display: none;
    }
    .fp-akt:has(.fp-yil-sec label:nth-of-type(1) input:checked) .fp-yil:nth-of-type(1) {
      display: grid;
    }
    .fp-akt:has(.fp-yil-sec label:nth-of-type(2) input:checked) .fp-yil:nth-of-type(2) {
      display: grid;
    }
    .fp-akt:has(.fp-yil-sec label:nth-of-type(3) input:checked) .fp-yil:nth-of-type(3) {
      display: grid;
    }
    .fp-akt:has(.fp-yil-sec label:nth-of-type(4) input:checked) .fp-yil:nth-of-type(4) {
      display: grid;
    }
    .fp-akt:has(.fp-yil-sec label:nth-of-type(5) input:checked) .fp-yil:nth-of-type(5) {
      display: grid;
    }
    .fp-akt:has(.fp-yil-sec label:nth-of-type(6) input:checked) .fp-yil:nth-of-type(6) {
      display: grid;
    }
    .fp-akt:has(.fp-yil-sec label:nth-of-type(7) input:checked) .fp-yil:nth-of-type(7) {
      display: grid;
    }
    .fp-akt:has(.fp-yil-sec label:nth-of-type(8) input:checked) .fp-yil:nth-of-type(8) {
      display: grid;
    }
    .fp-akt:has(.fp-yil-sec label:nth-of-type(9) input:checked) .fp-yil:nth-of-type(9) {
      display: grid;
    }
    .fp-akt:has(.fp-yil-sec label:nth-of-type(10) input:checked) .fp-yil:nth-of-type(10) {
      display: grid;
    }
    .fp-akt:has(.fp-yil-sec label:nth-of-type(11) input:checked) .fp-yil:nth-of-type(11) {
      display: grid;
    }
    .fp-akt:has(.fp-yil-sec label:nth-of-type(12) input:checked) .fp-yil:nth-of-type(12) {
      display: grid;
    }
    .fp-yil-no {
      display: none;
    }
    .fp-yil {
      grid-template-columns: minmax(0, 1fr) !important;
    }
  }
  @supports not selector(:has(*)) {
    .fp-yil-sec {
      display: none;
    }
  }
  .fp-yillar {
    display: grid;
    gap: 16px;
  }
  .fp-yil {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: start;
    gap: 16px;
  }
  .fp-yil-no {
    padding-top: 18px;
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  /* İki yarı: geniş ekranda yan yana (tek satır gibi), dar ekranda alt alta. Yatay kaydırma yok. */
  .fp-yil-cerceve {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--rom);
    row-gap: 16px;
  }
  .fp-yari {
    width: max-content;
  }
  .fp-ay-satiri {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--rute);
    column-gap: var(--rom);
    height: 16px;
  }
  .fp-ay-satiri span {
    overflow: visible;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--gri);
    white-space: nowrap;
  }
  .fp-gunler {
    display: grid;
    grid-template-rows: repeat(7, var(--rute));
    grid-auto-flow: column;
    grid-auto-columns: var(--rute);
    gap: var(--rom);
  }
  .d {
    display: block;
    width: var(--rute);
    height: var(--rute);
    background: var(--bos);
  }
  .d.x {
    background: none;
  }
  /* Bugünden sonraki günler: boş kutu, biraz daha soluk. */
  .d.f {
    opacity: 0.55;
  }
  .d.h {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 1px;
    background: var(--bos);
  }
  .d.h i,
  .fp-mini i {
    display: block;
  }
  .s-tidsrost {
    background: var(--c-tidsrost);
  }
  .s-jendume {
    background: var(--c-jendume);
  }
  .s-finfolis {
    background: var(--c-finfolis);
  }
  .s-kifobu {
    background: var(--c-kifobu);
  }
  /* Kayıtsız dönem: üç site her gün dolu, açık tonda; parçaların yeri günden güne karışık. */
  .d.e .s-jendume {
    background: color-mix(in srgb, var(--c-jendume) 52%, var(--kagit));
  }
  .d.e .s-finfolis {
    background: color-mix(in srgb, var(--c-finfolis) 52%, var(--kagit));
  }
  .d.e .s-kifobu {
    background: color-mix(in srgb, var(--c-kifobu) 52%, var(--kagit));
  }
  .fp-mini {
    display: grid;
    grid-template-columns: 7px 7px;
    grid-template-rows: 7px 7px;
    gap: 1px;
    background: var(--bos);
