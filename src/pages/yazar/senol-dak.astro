---
// Yazar sayfası: analiz, açıklayıcı ve köşe yazılarının görünen yazarı. Biyografi uydurulmaz; yalnız ad, unvan, nötr tek cümle,
// iletişim e-postası ve son yazılar yer alır.
import Base from '../../layouts/Base.astro';
import HaberSatiri from '../../components/HaberSatiri.astro';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { SITE, YAZAR, yazarLd, yazarUrl, kisiYazariMi } from '../../lib/site';
import { getNews, newsUrl } from '../../lib/news';
import { kunyeParcalari } from '../../lib/kunye.mjs';

const haberler = (await getNews()).filter((h) => kisiYazariMi(h.data));
const sayfaUrl = yazarUrl(Astro.site!);
const siteUrl = new URL('/', Astro.site).href;
const aciklama = YAZAR.kunye[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${sayfaUrl}#page`,
      url: sayfaUrl,
      name: YAZAR.ad,
      description: aciklama,
      inLanguage: 'tr-TR',
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { ...yazarLd(Astro.site!), description: aciklama, email: YAZAR.epost, image: new URL('/yazar-foto/senol-dak.jpg', Astro.site).href },
      hasPart: haberler.slice(0, 50).map((h) => ({
        '@type': 'NewsArticle',
        url: new URL(newsUrl(h), Astro.site).href,
        headline: h.data.title,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: YAZAR.ad, item: sayfaUrl },
      ],
    },
  ],
};
---

<Base title={`${YAZAR.ad}: ${YAZAR.unvan}`} description={aciklama}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <article class="makale">
    <header class="makale-bas">
      <img class="yazar-foto" src="/yazar-foto/senol-dak.jpg" width="96" height="96" alt="Şenol Dak" />
      <h1>{YAZAR.ad}</h1>
      <p class="makale-spot">{YAZAR.unvan}</p>
    </header>
    <div class="metin">
      {YAZAR.kunye.map((p) => <p>{kunyeParcalari(p).map((x) => (x.adres ? <a href={x.adres}>{x.metin}</a> : x.metin))}</p>)}
      <p>İletişim: <a href={`mailto:${YAZAR.epost}`}>{YAZAR.epost}</a></p>
    </div>
  </article>
  <section class="bolum" aria-labelledby="son-yazilar">
    <div class="bolum-bas">
      <h2 class="bolum-baslik" id="son-yazilar">Son yazılar</h2>
    </div>
    <div class="satir-izgara">
      {haberler.slice(0, 30).map((h) => <HaberSatiri haber={h} />)}
    </div>
  </section>
</Base>

<style>
  /* Yazar fotoğrafı: sitenin kendi renklerinde (mürekkep, marka rengi, kâğıt) üç duraklı ton. */
  .yazar-foto {
    display: block;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 0 16px;
  }
</style>
