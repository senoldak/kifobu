              <td class={`yz ${yonSinifi(s.alis?.dagitimaGore)}`} data-yt={yonSinifi(s.alis?.dagitimaGore)} data-yu={yonSinifi(s.usd.alisDagitimaGore)} data-ye={yonSinifi(s.eur.alisDagitimaGore)} data-yx={yonSinifi(s.xau.alisDagitimaGore)} data-d={s.alis?.dagitimaGore ?? ''} data-du={s.usd.alisDagitimaGore ?? ''} data-de={s.eur.alisDagitimaGore ?? ''} data-dx={s.xau.alisDagitimaGore ?? ''}><span class="p-tl">{yuzdeYaz(s.alis?.dagitimaGore)}</span><span class="p-usd">{yuzdeYaz(s.usd.alisDagitimaGore)}</span><span class="p-eur">{yuzdeYaz(s.eur.alisDagitimaGore)}</span><span class="p-xau">{yuzdeYaz(s.xau.alisDagitimaGore)}</span></td>
