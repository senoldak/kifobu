<script>
  const tablo = document.querySelector<HTMLTableElement>('[data-sk-tablo]');
  const ara = document.querySelector<HTMLInputElement>('[data-sk-ara]');
  const suzDugmeler = [...document.querySelectorAll<HTMLButtonElement>('[data-sk-suz]')];
  if (tablo && ara) {
    const govde = tablo.tBodies[0];
    let suz = 'ilanli';
    let para = 'tl';
    const paraDugmeler = [...document.querySelectorAll<HTMLButtonElement>('[data-sk-para]')];
    const paraUygula = (p: string) => {
      para = p === 'usd' || p === 'eur' || p === 'xau' ? p : 'tl';
      document.documentElement.dataset.para = para;
      tablo.classList.toggle('para-usd', para === 'usd');
      tablo.classList.toggle('para-eur', para === 'eur');
      tablo.classList.toggle('para-xau', para === 'xau');
      for (const x of paraDugmeler) x.setAttribute('aria-pressed', String(x.dataset.skPara === para));
      for (const td of tablo.querySelectorAll<HTMLTableCellElement>('td.yz')) {
        td.classList.remove('artı', 'eksi');
        const y = para === 'usd' ? td.dataset.yu : para === 'eur' ? td.dataset.ye : para === 'xau' ? td.dataset.yx : td.dataset.yt;
        if (y) td.classList.add(y);
      }
      try { localStorage.setItem('sekundery-para', para); } catch { /* tarayıcı izin vermiyorsa yalnız bu oturum */ }
    };
    for (const d of paraDugmeler) d.addEventListener('click', () => paraUygula(d.dataset.skPara ?? 'tl'));
    try { const p = localStorage.getItem('sekundery-para'); if (p === 'usd' || p === 'eur' || p === 'xau') paraUygula(p); } catch { /* yok say */ }
    const uygula = () => {
      const q = ara.value.trim().toLocaleLowerCase('tr-TR');
      for (const tr of govde.rows) {
        const gor = (suz === 'hepsi' || tr.dataset.ilanli === '1') && (!q || (tr.dataset.ara ?? '').includes(q));
        tr.hidden = !gor;
      }
    };
    ara.addEventListener('input', uygula);
    for (const d of suzDugmeler)
      d.addEventListener('click', () => {
        suz = d.dataset.skSuz ?? 'ilanli';
        for (const x of suzDugmeler) x.setAttribute('aria-pressed', String(x === d));
        uygula();
      });

    const basliklar = [...tablo.tHead!.rows[1].cells];
    basliklar.forEach((th, sutun) => {
      th.tabIndex = 0;
      const sirala = () => {
        const yon = th.getAttribute('aria-sort') === 'descending' ? 'ascending' : 'descending';
        for (const b of basliklar) b.removeAttribute('aria-sort');
        th.setAttribute('aria-sort', yon);
        const sayi = th.dataset.sirala === 'sayi';
        const k = yon === 'ascending' ? 1 : -1;
        const deger = (tr: HTMLTableRowElement) => { const ds = tr.cells[sutun].dataset; return (para === 'usd' && ds.du !== undefined ? ds.du : para === 'eur' && ds.de !== undefined ? ds.de : para === 'xau' && ds.dx !== undefined ? ds.dx : ds.d) ?? ''; };
        const rows = [...govde.rows].sort((a, b) => {
          const x = deger(a), y = deger(b);
          if (x === '' && y === '') return 0;
          if (x === '') return 1;
          if (y === '') return -1;
          return (sayi ? Number(x) - Number(y) : x.localeCompare(y, 'tr')) * k;
        });
        govde.append(...rows);
      };
      th.addEventListener('click', sirala);
      th.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); sirala(); } });
    });
  }
</script>

