---
// Girişim sayfası: bir şirketin bütün pay grupları ve kampanyaları tek yerde. Kampanya adı ve slogan gösterilmez (sahibin kuralı).
import Base from '../../../layouts/Base.astro';
import SekunderyMenu from '../../../components/sekundery/SekunderyMenu.astro';
import SekunderyIzah from '../../../components/sekundery/SekunderyIzah.astro';
import SekunderyUyari from '../../../components/sekundery/SekunderyUyari.astro';
import BirimSecici from '../../../components/sekundery/BirimSecici.astro';
import VirmanGecmisi from '../../../components/sekundery/VirmanGecmisi.astro';
import Yol from '../../../components/Yol.astro';
import { tumAnahtarlar, satir, sonGun } from '../../../lib/sekundery-veri.mjs';
import { yuzdeYaz } from '../../../lib/sekundery.mjs';
import { paraYaz } from '../../../lib/sekundery-kur.mjs';
import { tamUnvan } from '../../../lib/sekundery-virman.mjs';
import kampanyaVeri from '../../../data/sekundery/kampanyalar.json';

export function getStaticPaths() {
  const kodlar = [...new Set(tumAnahtarlar().map((k) => k.split('-')[0]))];
  return kodlar.map((kod) => ({ params: { kod: kod.toLowerCase() }, props: { kod } }));
}

const { kod } = Astro.props as { kod: string };
const gruplar = tumAnahtarlar().filter((k) => k.split('-')[0] === kod).map((k) => satir(k));
const sirket = (kampanyaVeri.sirketler as Record<string, any>)[kod] ?? null;
const unvan = tamUnvan(sirket?.unvan ?? gruplar[0]?.unvan ?? null);
const kampanyalar = [...(sirket?.kampanyalar ?? [])].sort((a: any, b: any) => (a.fonAktarim ?? '').localeCompare(b.fonAktarim ?? ''));
const P = ['tl', 'usd', 'eur', 'xau'] as const;
const tarihYaz = (t?: string | null) => (t ? new Date(`${t}T12:00:00`).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }) : '—');
const fiyat = (s: any, alan: 'dagitim' | 'itoEnf' | 'satis' | 'alis') => P.map((p) => {
  const v = p === 'tl' ? (alan === 'satis' ? s.satis?.enIyi : alan === 'alis' ? s.alis?.enIyi : s[alan]) : s[p]?.[alan];
  return { p, m: paraYaz(v ?? null, p) };
});
const yon = (y: number | null | undefined) => (y == null ? '' : y > 0 ? 'sr-a' : y < 0 ? 'sr-e' : '');
const baslik = `${kod}: bütün pay grupları`;
const aciklama = `${kod} girişiminin pay grupları, kampanyaları ve ilan özetleri.`;
const adimlar = [{ ad: 'Anasayfa', url: '/' }, { ad: 'Sekundery', url: '/sekundery/' }, { ad: kod, url: `/sekundery/sirket/${kod.toLowerCase()}/` }];
---

<Base title={baslik} description={aciklama} noindex>
  <Yol adimlar={adimlar} />
  <article class="sr">
    <SekunderyMenu etkin="grup" />
    <header class="sr-bas">
      <div>
        <p class="sr-etiket">SEKUNDERY · GİRİŞİM</p>
        <h1>{kod}</h1>
        {unvan && <p class="sr-unvan">{unvan}</p>}
      </div>
      <div class="sr-sag">
        {sonGun && <p class="sr-tarih">son güncelleme · {tarihYaz(sonGun.tarih)}</p>}
        <BirimSecici />
      </div>
    </header>

    <section class="sr-bolum" aria-labelledby="sr-gruplar">
      <h2 id="sr-gruplar">Pay grupları</h2>
      <div class="sr-kap">
        <table class="sr-t">
          <thead>
            <tr>
              <th scope="col">Pay grubu</th>
              <th scope="col">Dağıtım</th>
              <th scope="col">İTO enf.</th>
              <th scope="col">ENDU</th>
              <th scope="col" class="sr-iki">Dağıtıma<br />göre %</th>
              <th scope="col">ENYU</th>
              <th scope="col" class="sr-iki">Satış / alış<br />ilanı</th>
              <th scope="col">Pay sahibi</th>
              <th scope="col">ISIN</th>
            </tr>
          </thead>
          <tbody>
            {gruplar.map((s) => (
              <tr>
                <th scope="row"><a href={`/sekundery/${s.anahtar.toLowerCase()}/`}>{s.kod} <b>{s.grup}</b></a></th>
                <td>{fiyat(s, 'dagitim').map((x) => <span class={`pv pv-${x.p}`}>{x.m}</span>)}</td>
                <td>{fiyat(s, 'itoEnf').map((x) => <span class={`pv pv-${x.p}`}>{x.m}</span>)}</td>
                <td>{s.satis ? fiyat(s, 'satis').map((x) => <span class={`pv pv-${x.p}`}>{x.m}</span>) : '—'}</td>
                <td>{P.map((p) => { const y = p === 'tl' ? s.satis?.dagitimaGore : s[p]?.satisDagitimaGore; return <span class={`pv pv-${p} ${yon(y)}`}>{y == null ? '—' : yuzdeYaz(y)}</span>; })}</td>
                <td>{s.alis ? fiyat(s, 'alis').map((x) => <span class={`pv pv-${x.p}`}>{x.m}</span>) : '—'}</td>
                <td>{s.satis?.ilanSayisi ?? 0} / {s.alis?.ilanSayisi ?? 0}</td>
                <td>{s.sahip ? s.sahip.son.n.toLocaleString('tr-TR') : '—'}</td>
                <td class="sr-isin">{s.isin ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {kampanyalar.length > 0 && (
      <section class="sr-bolum" aria-labelledby="sr-kampanya">
        <h2 id="sr-kampanya">Kampanyalar</h2>
        <div class="sr-kap">
          <table class="sr-t">
            <thead>
              <tr>
                <th scope="col">Sıra</th>
                <th scope="col">Fon aktarımı</th>
                <th scope="col">Yatırımcı</th>
                <th scope="col">Sermaye</th>
                <th scope="col">Toplam dağıtım</th>
                <th scope="col">Dağıtım fiyatı</th>
                <th scope="col">Pay grupları</th>
              </tr>
            </thead>
            <tbody>
              {kampanyalar.map((k: any, i: number) => (
                <tr>
                  <th scope="row">{i + 1}. kampanya</th>
                  <td>{tarihYaz(k.fonAktarim)}</td>
                  <td>{k.yatirimci != null ? k.yatirimci.toLocaleString('tr-TR') : '—'}</td>
                  <td>{k.sermaye != null ? paraYaz(k.sermaye, 'tl', 0) : '—'}</td>
                  <td>{k.dagitimOrani != null ? `%${k.dagitimOrani.toLocaleString('tr-TR')}` : '—'}</td>
                  <td>{k.dagitimFiyati != null ? paraYaz(k.dagitimFiyati, 'tl') : '—'}</td>
                  <td>{(k.gruplar ?? []).join(', ') || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="sr-not">Kampanya tutarları kampanya günündeki TL değeridir.</p>
      </section>
    )}

    <VirmanGecmisi kod={kod} />

    <SekunderyIzah sayfa="sirket" />
    <SekunderyUyari />
  </article>
</Base>

<style>
  .sr { max-width: 1180px; margin: 0 auto; padding: 0 16px 64px; }
  .sr-bas { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; border-top: 10px solid var(--marka-sari); padding-top: 18px; margin-bottom: 26px; }
  .sr-etiket { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; color: var(--gri); margin: 0; }
  .sr-bas h1 { font-size: clamp(2.6rem, 6vw, 4.2rem); letter-spacing: -0.04em; line-height: 0.95; margin: 6px 0 8px; }
  .sr-unvan { font-size: clamp(0.95rem, 2vw, 1.15rem); font-weight: 600; letter-spacing: 0.02em; margin: 0; }
  .sr-sag { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .sr-tarih { color: var(--gri); margin: 0; font-size: 0.82rem; }
  .sr-bolum { margin: 0 0 36px; }
  .sr-bolum h2 { font-size: 1.2rem; letter-spacing: -0.01em; margin: 0 0 10px; padding-bottom: 6px; border-bottom: 2px solid var(--marka-sari); display: inline-block; }
  .sr-kap { overflow-x: auto; border: 1px solid var(--cizgi); background: var(--beyaz); }
  .sr-t { width: 100%; border-collapse: collapse; font-size: 0.84rem; font-variant-numeric: tabular-nums; }
  .sr-t th, .sr-t td { padding: 9px 10px; text-align: right; border-bottom: 1px solid var(--cizgi); white-space: nowrap; }
  .sr-t thead th { font-size: 0.64rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--gri); background: var(--kagit); vertical-align: bottom; }
  .sr-t thead th.sr-iki { white-space: normal; line-height: 1.2; }
  .sr-t th:first-child { text-align: left; }
  .sr-t tbody th a { color: var(--murekkep); text-decoration: none; font-weight: 700; }
  .sr-t tbody th a b { color: var(--marka-sari); }
  .sr-t tbody th a:hover { text-decoration: underline; }
  .sr-t .sr-a { color: #8a6a00; font-weight: 600; }
  .sr-t .sr-e { color: #2f4b6e; font-weight: 600; }
  .sr-isin { font-size: 0.76rem; color: var(--murekkep-2); }
  .sr-not { margin: 6px 0 0; font-size: 0.78rem; color: var(--gri); }
</style>
