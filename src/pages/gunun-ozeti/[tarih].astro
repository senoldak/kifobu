---
// Telegram Günün Özeti'nin gün sayfası (/gunun-ozeti/YYYY-AA-GG/): 20:45 işinin yazdığı paragraf, o günün bülten
// yazıları ve haberleri. Yalnız paragrafı yazılmış günler için üretilir; RSS'e ve ana sayfa akışına girmez.
// gunun-ozeti ve gunun-ozeti-paragraf meta etiketlerini mecmua-saat kuyruğu okur (paragraf og:description'da kısalır).
import Base from '../../layouts/Base.astro';
import HaberSatiri from '../../components/HaberSatiri.astro';
import Yol from '../../components/Yol.astro';
import { dizinVerisi } from '../../lib/dizin';
import { gunUrl } from '../../lib/gunler';
import { ozetKapakUrl, ozetKayitlari, ozetSayfasi, ozetUrl, type OzetKaydi } from '../../lib/gunun-ozeti';
import type { Haber } from '../../lib/news';

export async function getStaticPaths() {
  const kayitlar = ozetKayitlari(import.meta.glob('/src/data/gunun-ozeti/*.json', { eager: true, import: 'default' }));
  const { gunler } = await dizinVerisi();
  return kayitlar.map((kayit, i) => ({
    params: { tarih: kayit.tarih },
    props: { kayit, gun: gunler.find((g) => g.tarih === kayit.tarih), yeni: kayitlar[i - 1]?.tarih, eski: kayitlar[i + 1]?.tarih },
  }));
}

interface Props {
  kayit: OzetKaydi;
  gun?: { haberler: Haber[]; bultenler: Haber[] };
  yeni?: string;
  eski?: string;
}

const { kayit, gun, yeni, eski } = Astro.props;
const s = ozetSayfasi(kayit, gun);
const adimlar = [{ ad: 'Anasayfa', url: '/' }, { ad: 'Günün Özeti', url: ozetUrl(kayit.tarih) }];
const kisa = (t: string) => ozetSayfasi({ ...kayit, tarih: t }, undefined).tarihAd;
---

<Base
  title={s.baslik}
  description={kayit.paragraf}
  image={ozetKapakUrl(kayit.tarih)}
  imageWidth={1200}
  imageHeight={675}
  imageAlt={`${s.baslik}: günün öne çıkan haber başlıkları`}
  noindex={s.toplam < 3}
>
  <meta slot="head" name="linkedin-gorsel" content={new URL(`/kapak/gunun-ozeti/dikey/${kayit.tarih}.png`, Astro.site).href} />
  <Fragment slot="head">
    <meta name="gunun-ozeti" content={kayit.tarih} />
    <meta name="gunun-ozeti-paragraf" content={kayit.paragraf} />
  </Fragment>
  <div slot="tahta" class="kategori-bas">
    <h1 class="kategori-isim">Günün Özeti</h1>
    <p class="kategori-sayi">{s.tarihAd}</p>
  </div>
  <Yol adimlar={adimlar} />

  <section class="bolum bolum-ilk" aria-label="Günün özeti">
    <p class="makale-spot">{kayit.paragraf}</p>
    {kayit.yazan === 'gemini' && <p class="dizin-not">Bu paragraf o günün haberlerinden yapay zekâ ile yazıldı.</p>}
  </section>

  {
    s.bultenler.length > 0 && (
      <section class="bolum" aria-labelledby="ozet-bultenler">
        <div class="bolum-bas">
          <h2 class="bolum-baslik" id="ozet-bultenler">Bülten yazıları</h2>
        </div>
        <div class="satir-izgara">
          {s.bultenler.map((h) => (
            <HaberSatiri haber={h} showCategory={false} withTime />
          ))}
        </div>
      </section>
    )
  }

  {
    s.haberler.length > 0 && (
      <section class="bolum" aria-labelledby="ozet-haberler">
        <div class="bolum-bas">
          <h2 class="bolum-baslik" id="ozet-haberler">{s.tarihAd} haberleri</h2>
        </div>
        <div class="satir-izgara">
          {s.haberler.map((h) => (
            <HaberSatiri haber={h} withTime />
          ))}
        </div>
      </section>
    )
  }

  <p class="dizin-not"><a href={gunUrl(kayit.tarih)}>Günün kitle fonlama bülteni →</a></p>

  <nav class="sayfalama" aria-label="Özet günleri">
    {yeni ? <a href={ozetUrl(yeni)} rel="prev">← {kisa(yeni)}</a> : <span />}
    <span />
    {eski ? <a href={ozetUrl(eski)} rel="next">{kisa(eski)} →</a> : <span />}
  </nav>
</Base>
