---
import Base from '../layouts/Base.astro';
import Yol from '../components/Yol.astro';
import mkkVerisi from '../data/resmi-mkk.json';
import { formatNumber } from '../lib/site';

const baslik = 'MKK Kitle Fonlaması ve Girişim Piyasası Verileri';
const aciklama = 'Merkezi Kayıt Kuruluşu (MKK) resmi aylık piyasa bülteni verileriyle Türkiye kitle fonlaması ekosistemi (KFS) ve girişim sermayesi fonları (GSYF) 13 aylık interaktif zaman serisi.';

const adimlar = [
  { ad: 'Anasayfa', url: '/' },
  { ad: 'MKK Verileri', url: '/mkk-verileri/' }
];

const kfs = mkkVerisi.kfs;
const gsyf = mkkVerisi.gsyf;
const sonKfs = kfs.zaman_serisi[kfs.zaman_serisi.length - 1];
const sonGsyf = gsyf.zaman_serisi[gsyf.zaman_serisi.length - 1];

const grafikPaketi = {
  kfs: kfs.zaman_serisi,
  gsyf: gsyf.zaman_serisi
};
---

<Base title={baslik} description={aciklama}>
  <div slot="tahta" class="kategori-bas">
    <h1 class="kategori-isim">MKK Resmi Piyasa Göstergeleri</h1>
    <p class="kategori-sayi">Kitle Fonlaması (KFS) &amp; Girişim Sermayesi (GSYF) İnteraktif Terminali</p>
  </div>

  <Yol adimlar={adimlar} />

  <article class="makale mkk-sayfa">
    <header class="mkk-ust-bilgi">
      <div class="mkk-rozet-satir">
        <span class="mkk-kaynak-etiket">RESMİ BİRİNCİL VERİ</span>
        <span class="mkk-bulten-etiket">{mkkVerisi.kaynak.bulten}</span>
        <span class="mkk-guncel-nokta" title="Doğrulanmış MKK Kaydı"></span>
      </div>
      <p class="mkk-spot">
        Merkezi Kayıt Kuruluşu (MKK) tarafından yayımlanan aylık piyasa bültenlerinden derlenen resmi kitle fonlaması ve kurumsal girişim fonu göstergeleridir. Değerler üzerinde tahmin ya da türetme yapılmaz.
      </p>
    </header>

    <!-- 4 Büyük Canlı İndikatör Kartı -->
    <div class="mkk-kartlar-izgara">
      <div class="mkk-kart">
        <span class="mkk-kart-baslik">KFS Toplam Fonlanan Tutar</span>
        <div class="mkk-kart-sayi">₺{sonKfs.fonlanan_milyar_tl.toFixed(2).replace('.', ',')} Mr</div>
        <div class="mkk-kart-degisim pozitif">
          <span class="vurgu-oran">▲ {kfs.degisim.fonlanan.yillik}</span>
          <span class="mkk-alt-degisim">1 yılda fonlama büyümesi (3A: {kfs.degisim.fonlanan.ucAylik})</span>
        </div>
      </div>

      <div class="mkk-kart">
        <span class="mkk-kart-baslik">KFS Yatırımcı Sayısı</span>
        <div class="mkk-kart-sayi">{formatNumber(sonKfs.yatirimci_sayisi)}</div>
        <div class="mkk-kart-degisim pozitif">
          <span class="vurgu-oran">▲ {kfs.degisim.yatirimci.yillik}</span>
          <span class="mkk-alt-degisim">1 yılda yatırımcı artışı (Aylık: {kfs.degisim.yatirimci.aylik})</span>
        </div>
      </div>

      <div class="mkk-kart">
        <span class="mkk-kart-baslik">Kaydileşen Girişim</span>
        <div class="mkk-kart-sayi">{kfs.kaydilesen_sirket}</div>
        <div class="mkk-kart-not">MKS nezdinde payları kayden ihraç edilen başarılı girişimler</div>
      </div>

      <div class="mkk-kart">
        <span class="mkk-kart-baslik">GSYF Portföy Büyüklüğü</span>
        <div class="mkk-kart-sayi">₺{sonGsyf.portfoy_milyar_tl} Mr</div>
        <div class="mkk-kart-degisim pozitif">
          <span class="vurgu-oran">▲ {gsyf.degisim.portfoy.yillik}</span>
          <span class="mkk-alt-degisim">Girişim Sermayesi Fonları ({formatNumber(sonGsyf.yatirimci_sayisi)} yatırımcı)</span>
        </div>
      </div>
    </div>

    <!-- FİNFOLİS KALİTESİNDE İNTERAKTİF GRAFİK BİLEŞENİ -->
    <section class="finfolis-grafik-karti" data-mkk-grafik>
      <!-- CSP Güvenli Veri Kapsayıcısı -->
      <script type="application/json" class="fg-veri-json" set:html={JSON.stringify(grafikPaketi)} />

      <header class="fg-ust">
        <div class="fg-baslik-blok">
          <h2 class="fg-baslik">Türkiye Kitle Fonlaması &amp; Girişim Sermayesi Zaman Serisi</h2>
          <p class="fg-aciklama">13 Aylık resmi MKK bülten kayıtları; imleci grafik üzerinde gezdirerek değerleri inceleyebilirsiniz.</p>
        </div>

        <div class="fg-kontroller">
          <div class="fg-mod-secici" role="tablist" aria-label="Veri Serisi">
            <button type="button" class="fg-sekme aktif" data-seri="kfs-fon" aria-selected="true">
              <span class="renk-nokta mavi"></span> KFS Fon Tutarı (Milyar TL)
            </button>
            <button type="button" class="fg-sekme" data-seri="kfs-yat" aria-selected="false">
              <span class="renk-nokta yesil"></span> KFS Yatırımcı Sayısı
            </button>
            <button type="button" class="fg-sekme" data-seri="gsyf-port" aria-selected="false">
              <span class="renk-nokta toprak"></span> GSYF Portföyü (Milyar TL)
            </button>
          </div>

          <div class="fg-aralik-secici" role="group" aria-label="Zaman Aralığı">
            <button type="button" class="fg-aralik-btn" data-aralik="6">6 Ay</button>
            <button type="button" class="fg-aralik-btn aktif" data-aralik="13">13 Ay (Tümü)</button>
          </div>
        </div>
      </header>

      <!-- İnteraktif SVG ve Bilgi İpucu (Tooltip) Alanı -->
      <div class="fg-cizim-alani">
        <div class="fg-ipucu" data-ipucu hidden>
          <div class="fg-ipucu-tarih" data-ipucu-tarih>30.09.2026</div>
          <div class="fg-ipucu-deger" data-ipucu-deger>₺1,60 Milyar</div>
          <div class="fg-ipucu-ek" data-ipucu-ek>Yıllık Değişim: %+28,00</div>
        </div>

        <svg class="fg-svg" viewBox="0 0 840 320" preserveAspectRatio="none" data-svg>
          <defs>
            <linearGradient id="maviDegrade" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#2563eb" stop-opacity="0.28" />
              <stop offset="100%" stop-color="#2563eb" stop-opacity="0.0" />
            </linearGradient>
            <linearGradient id="yesilDegrade" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#10b981" stop-opacity="0.28" />
              <stop offset="100%" stop-color="#10b981" stop-opacity="0.0" />
            </linearGradient>
            <linearGradient id="toprakDegrade" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#d97706" stop-opacity="0.28" />
              <stop offset="100%" stop-color="#d97706" stop-opacity="0.0" />
            </linearGradient>
          </defs>

          <!-- Izgara Çizgileri -->
          <g class="fg-izgara" data-izgara></g>

          <!-- Alan ve Çizgi -->
          <path class="fg-alan" data-alan fill="url(#maviDegrade)" />
          <path class="fg-cizgi" data-cizgi fill="none" stroke="#2563eb" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

          <!-- Dikey İmleç Çizgisi -->
          <line class="fg-imlec-cizgi" data-imlec-cizgi x1="0" y1="30" x2="0" y2="270" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3,3" opacity="0" />

          <!-- Vurgu Noktası -->
          <circle class="fg-vurgu-nokta" data-vurgu-nokta cx="0" cy="0" r="6" fill="#ffffff" stroke="#2563eb" stroke-width="3" opacity="0" />

          <!-- Etkileşim Katmanı -->
          <rect class="fg-hitbox" x="0" y="0" width="840" height="320" fill="transparent" />
        </svg>
      </div>

      <footer class="fg-alt">
        <div class="fg-kaynak-notu">
          Kaynak: <strong>Merkezi Kayıt Kuruluşu (MKK)</strong> Aylık Piyasa Bültenleri &amp; VAP Veri Tabanı.
        </div>
        <div class="fg-canli-durum">
          <span class="mkk-guncel-nokta"></span> Resmi Kayıt: 30 Eylül 2026 Kapanışı
        </div>
      </footer>
    </section>

    <!-- 13 Aylık Resmi Karşılaştırmalı Tablo -->
    <section class="mkk-tablo-bolumu" aria-labelledby="tablo-baslik">
      <div class="mkk-tablo-baslik-satiri">
        <h2 id="tablo-baslik" class="bolum-baslik">13 Aylık Resmi Zaman Serisi Veri Tablosu</h2>
        <span class="mkk-tablo-etiket">Tüm Rakamlar Kesinleşmiş MKK İbrazıdır</span>
      </div>
      
      <div class="tablo-kap">
        <table class="veri-tablo mkk-tablo">
          <thead>
            <tr>
              <th scope="col">Tarih</th>
              <th scope="col" class="sayi">KFS Fonlama (TL)</th>
              <th scope="col" class="sayi">KFS Yatırımcı</th>
              <th scope="col" class="sayi">GSYF Portföy (TL)</th>
              <th scope="col" class="sayi">GSYF Yatırımcı</th>
              <th scope="col" class="sayi">Platform</th>
            </tr>
          </thead>
          <tbody>
            {kfs.zaman_serisi.map((item, i) => {
              const gItem = gsyf.zaman_serisi[i] ?? { portfoy_milyar_tl: 0, yatirimci_sayisi: 0 };
              const sonMu = i === kfs.zaman_serisi.length - 1;
              return (
                <tr class={sonMu ? 'vurgulu-satir' : ''}>
                  <th scope="row" class="kalin">
                    {item.tarih}
                    {sonMu && <span class="son-rozet">Son Ay</span>}
                  </th>
                  <td class="sayi"><strong>₺{item.fonlanan_milyar_tl.toFixed(2).replace('.', ',')} Mr</strong></td>
                  <td class="sayi">{formatNumber(item.yatirimci_sayisi)}</td>
                  <td class="sayi">₺{gItem.portfoy_milyar_tl} Mr</td>
                  <td class="sayi">{formatNumber(gItem.yatirimci_sayisi)}</td>
                  <td class="sayi">18</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="dizin-not">
        * Not: GSYF portföy değerleri, fon kurucuları ve portföy yönetim şirketleri tarafından geçmişe dönük fiyat düzeltmeleri yapılabildiği için dönemsel revizyonlara tabidir. KFS verileri MKS tescilli kesin tutarlardır.
      </p>
    </section>
  </article>
</Base>

<!-- Astro Harici JS Çıktısı (CSP script-src 'self' uyumlu) -->
<script>
  interface KfsItem {
    tarih: string;
    fonlanan_milyar_tl: number;
    yatirimci_sayisi: number;
  }
  interface GsyfItem {
    tarih: string;
    portfoy_milyar_tl: number;
    yatirimci_sayisi: number;
  }
  interface GrafikPaketi {
    kfs: KfsItem[];
    gsyf: GsyfItem[];
  }

  interface NoktaVeri {
    tarih: string;
    deger: number;
    etiket: string;
    ek: string;
    renk: string;
    degrade: string;
  }

  document.querySelectorAll<HTMLElement>('[data-mkk-grafik]').forEach((kok) => {
    const jsonEl = kok.querySelector<HTMLScriptElement>('.fg-veri-json');
    if (!jsonEl || !jsonEl.textContent) return;
    const veri: GrafikPaketi = JSON.parse(jsonEl.textContent);

    const svg = kok.querySelector<SVGSVGElement>('[data-svg]');
    const alan = kok.querySelector<SVGPathElement>('[data-alan]');
    const cizgi = kok.querySelector<SVGPathElement>('[data-cizgi]');
    const izgara = kok.querySelector<SVGGElement>('[data-izgara]');
    const imlecCizgi = kok.querySelector<SVGLineElement>('[data-imlec-cizgi]');
    const vurguNokta = kok.querySelector<SVGCircleElement>('[data-vurgu-nokta]');
    const ipucu = kok.querySelector<HTMLElement>('[data-ipucu]');
    const ipucuTarih = kok.querySelector<HTMLElement>('[data-ipucu-tarih]');
    const ipucuDeger = kok.querySelector<HTMLElement>('[data-ipucu-deger]');
    const ipucuEk = kok.querySelector<HTMLElement>('[data-ipucu-ek]');
    const hitbox = kok.querySelector<SVGRectElement>('.fg-hitbox');

    if (!svg || !alan || !cizgi || !izgara || !imlecCizgi || !vurguNokta || !ipucu || !hitbox) return;

    const W = 840;
    const H = 320;
    const P = { ust: 30, alt: 50, sol: 70, sag: 30 };
    const cizimW = W - P.sol - P.sag;
    const cizimH = H - P.ust - P.alt;

    let aktifSeri = 'kfs-fon';
    let aktifAralik = 13;
    let seriler: NoktaVeri[] = [];

    function seriyiHazirla() {
      const kfsData = veri.kfs;
      const gsyfData = veri.gsyf;
      const baslangic = aktifAralik === 6 ? Math.max(0, kfsData.length - 6) : 0;

      if (aktifSeri === 'kfs-fon') {
        seriler = kfsData.slice(baslangic).map((d) => ({
          tarih: d.tarih,
          deger: d.fonlanan_milyar_tl,
          etiket: `₺${d.fonlanan_milyar_tl.toFixed(2).replace('.', ',')} Milyar`,
          ek: 'MKK KFS Toplam Fon',
          renk: '#2563eb',
          degrade: 'url(#maviDegrade)',
        }));
      } else if (aktifSeri === 'kfs-yat') {
        seriler = kfsData.slice(baslangic).map((d) => ({
          tarih: d.tarih,
          deger: d.yatirimci_sayisi,
          etiket: `${d.yatirimci_sayisi.toLocaleString('tr-TR')} Yatırımcı`,
          ek: 'Kitle Fonlaması Yatırımcısı',
          renk: '#10b981',
          degrade: 'url(#yesilDegrade)',
        }));
      } else if (aktifSeri === 'gsyf-port') {
        seriler = gsyfData.slice(baslangic).map((d) => ({
          tarih: d.tarih,
          deger: d.portfoy_milyar_tl,
          etiket: `₺${d.portfoy_milyar_tl} Milyar`,
          ek: 'Girişim Sermayesi Yatırım Fonları',
          renk: '#d97706',
          degrade: 'url(#toprakDegrade)',
        }));
      }
    }

    function ciz() {
      seriyiHazirla();
      if (seriler.length === 0) return;

      const degerler = seriler.map((s) => s.deger);
      let min = Math.min(...degerler);
      let max = Math.max(...degerler);

      const span = max - min || 1;
      const pad = span * 0.12;
      min = Math.max(0, min - pad);
      max = max + pad;

      const getX = (i: number) => P.sol + (i / (seriler.length - 1)) * cizimW;
      const getY = (val: number) => P.ust + (1 - (val - min) / (max - min)) * cizimH;

      let izgaraHtml = '';
      const adimSayisi = 4;
      for (let i = 0; i <= adimSayisi; i++) {
        const y = P.ust + (i / adimSayisi) * cizimH;
        const val = max - (i / adimSayisi) * (max - min);
        let valStr = '';
        if (aktifSeri === 'kfs-fon') valStr = `₺${val.toFixed(2).replace('.', ',')} Mr`;
        else if (aktifSeri === 'kfs-yat') valStr = Math.round(val).toLocaleString('tr-TR');
        else if (aktifSeri === 'gsyf-port') valStr = `₺${Math.round(val)} Mr`;

        izgaraHtml += `
          <line x1="${P.sol}" y1="${y}" x2="${W - P.sag}" y2="${y}" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="3,3" />
          <text x="${P.sol - 12}" y="${y + 4}" text-anchor="end" font-size="11" fill="currentColor" fill-opacity="0.55" font-family="monospace">${valStr}</text>
        `;
      }

      seriler.forEach((s, idx) => {
        const x = getX(idx);
        const ayAd = s.tarih.slice(3, 10);
        izgaraHtml += `
          <line x1="${x}" y1="${H - P.alt}" x2="${x}" y2="${H - P.alt + 6}" stroke="currentColor" stroke-opacity="0.25" />
          <text x="${x}" y="${H - P.alt + 22}" text-anchor="middle" font-size="10.5" fill="currentColor" fill-opacity="0.65">${ayAd}</text>
        `;
      });
      izgara.innerHTML = izgaraHtml;

      let yolD = '';
      seriler.forEach((s, idx) => {
        const x = getX(idx);
        const y = getY(s.deger);
        yolD += `${idx === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)} `;
      });

      cizgi.setAttribute('d', yolD);
      cizgi.setAttribute('stroke', seriler[0].renk);

      const alanD = `${yolD} L ${getX(seriler.length - 1).toFixed(1)} ${H - P.alt} L ${getX(0).toFixed(1)} ${H - P.alt} Z`;
      alan.setAttribute('d', alanD);
      alan.setAttribute('fill', seriler[0].degrade);

      vurguNokta.setAttribute('stroke', seriler[0].renk);
    }

    function fareHareketi(e: MouseEvent | TouchEvent) {
      const rect = svg.getBoundingClientRect();
      const clientX = 'clientX' in e ? e.clientX : e.touches?.[0]?.clientX ?? 0;
      const relX = ((clientX - rect.left) / rect.width) * W;

      if (relX < P.sol || relX > W - P.sag) {
        imlecCizgi.setAttribute('opacity', '0');
        vurguNokta.setAttribute('opacity', '0');
        ipucu.hidden = true;
        return;
      }

      const noktaAralik = cizimW / (seriler.length - 1);
      let enYakinIdx = Math.round((relX - P.sol) / noktaAralik);
      enYakinIdx = Math.max(0, Math.min(seriler.length - 1, enYakinIdx));

      const s = seriler[enYakinIdx];
      const degerler = seriler.map((item) => item.deger);
      let min = Math.min(...degerler);
      let max = Math.max(...degerler);
      const span = max - min || 1;
      const pad = span * 0.12;
      min = Math.max(0, min - pad);
      max = max + pad;

      const x = P.sol + (enYakinIdx / (seriler.length - 1)) * cizimW;
      const y = P.ust + (1 - (s.deger - min) / (max - min)) * cizimH;

      imlecCizgi.setAttribute('x1', String(x));
      imlecCizgi.setAttribute('x2', String(x));
      imlecCizgi.setAttribute('opacity', '0.7');

      vurguNokta.setAttribute('cx', String(x));
      vurguNokta.setAttribute('cy', String(y));
      vurguNokta.setAttribute('opacity', '1');

      if (ipucuTarih) ipucuTarih.textContent = s.tarih;
      if (ipucuDeger) ipucuDeger.textContent = s.etiket;
      if (ipucuEk) ipucuEk.textContent = s.ek;
      ipucu.hidden = false;

      const screenX = (x / W) * rect.width;
      const screenY = (y / H) * rect.height;
      ipucu.style.transform = `translate(${screenX}px, ${screenY}px)`;
    }

    hitbox.addEventListener('mousemove', fareHareketi);
    hitbox.addEventListener('mouseleave', () => {
      imlecCizgi.setAttribute('opacity', '0');
      vurguNokta.setAttribute('opacity', '0');
      ipucu.hidden = true;
    });

    hitbox.addEventListener('touchmove', fareHareketi, { passive: true });
    hitbox.addEventListener('touchend', () => {
      imlecCizgi.setAttribute('opacity', '0');
      vurguNokta.setAttribute('opacity', '0');
      ipucu.hidden = true;
    });

    kok.querySelectorAll<HTMLButtonElement>('.fg-sekme').forEach((btn) => {
      btn.addEventListener('click', () => {
        kok.querySelectorAll('.fg-sekme').forEach((b) => {
          b.classList.remove('aktif');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('aktif');
        btn.setAttribute('aria-selected', 'true');
        aktifSeri = btn.getAttribute('data-seri') || 'kfs-fon';
        ciz();
      });
    });

    kok.querySelectorAll<HTMLButtonElement>('.fg-aralik-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        kok.querySelectorAll('.fg-aralik-btn').forEach((b) => b.classList.remove('aktif'));
        btn.classList.add('aktif');
        aktifAralik = parseInt(btn.getAttribute('data-aralik') || '13', 10);
        ciz();
      });
    });

    ciz();
  });
</script>

<style>
  .mkk-sayfa {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem 0 3.5rem;
  }
  .mkk-rozet-satir {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .mkk-kaynak-etiket {
    font-size: 0.725rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    background: #e0f2fe;
    color: #0369a1;
    border-radius: 4px;
    letter-spacing: 0.06em;
  }
  .mkk-bulten-etiket {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--renk-metin-hafif, #64748b);
  }
  .mkk-guncel-nokta {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
  }
  .mkk-spot {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--renk-metin-orta, #334155);
    margin-bottom: 2rem;
  }

  /* 4 Büyük İndikatör Kartı */
  .mkk-kartlar-izgara {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .mkk-kart {
    background: var(--renk-kart-zemin, #f8fafc);
    border: 1px solid var(--renk-kart-kenar, #e2e8f0);
    border-radius: 10px;
    padding: 1.35rem 1.25rem;
