---
// Pay grubunun ilan fiyatı geçmişi (Lightweight Charts; finfolis Rasathane'deki yapı).
// Eksen yalnız veri olan günleri gösterir: ilanlar dönem dönem açık, kapalı aylar yer kaplamaz; çizgi kesintisizdir (sahibin kararı).
// JS kapalıyken grafik yerine "Rakamları göster" tablosu tek başına okunur.
import { fiyatYaz } from '../../lib/sekundery.mjs';
import { tohumIsaretiSvg } from '../../lib/kimlik';
import { kurBul } from '../../lib/sekundery-kur.mjs';
import { kurlar as usdK, avroKurlar as eurK, altinKurlar as xauK } from '../../lib/sekundery-veri.mjs';
import virmanVeri from '../../data/sekundery/virman.json';

interface Nokta { tarih: string; enDusukSatis: number | null; medyanSatis: number | null; enYuksekAlis: number | null; medyanAlis: number | null }
// donemsiz: ilanları sürekli açık olan pay grubu (ilan dönemi yok); dönem şeridi ve dönem ortalaması çizilmez.
interface Props { kod: string; seri: Nokta[]; dagitim: number | null; itoEnf: number | null; baslangic?: string | null; unvan?: string | null; donemsiz?: boolean }
const { kod, seri, dagitim, itoEnf, baslangic = null, unvan = null, donemsiz = false } = Astro.props;
// Birim görünümleri: her günün fiyatı o günün kuruyla; dağıtım çizgisi kampanya günü, İTO çizgisi son günün kuruyla.
const kaynak = { usd: usdK, eur: eurK, xau: xauK } as Record<string, Record<string, number>>;
const kur = Object.fromEntries(Object.entries(kaynak).map(([p, k]) => [p, {
  gun: seri.map((n) => kurBul(n.tarih, k)),
  bas: kurBul(baslangic, k),
  son: kurBul(seri.at(-1)?.tarih, k),
}]));
// İlan dönemleri (dönem duyurularından): grafikte açık şerit ve dönem ortalaması çizgisi için; yalnız seriyle kesişenler.
const ilk = seri[0]?.tarih ?? '', sonT = seri.at(-1)?.tarih ?? '';
const donemler = donemsiz ? [] : virmanVeri.donemler.filter((d) => d.kapanis >= ilk && d.acilis <= sonT).map((d) => ({ acilis: d.acilis, kapanis: d.kapanis }));
const veri = { kod, unvan, seri, dagitim, itoEnf, kur, donemler };
const tarihYaz = (t: string) => new Date(`${t}T12:00:00`).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<section class="ig" data-ig>
  <div class="ig-ust">
    <div>
      <h2>İlan fiyatlarının seyri</h2>
      <p class="ig-alt">Günlük · <span data-ig-birim>TL</span> · {new Date(`${seri[0].tarih}T12:00:00`).toLocaleDateString('tr-TR', { month: 'long', year: 'numeric' })} başından bu yana</p>
    </div>
    <div class="ig-dugmeler" data-ig-js hidden>
      <div class="ig-tf" role="group" aria-label="Zaman aralığı">
        <button type="button" data-ar="90" aria-pressed="false">3A</button>
        <button type="button" data-ar="180" aria-pressed="false">6A</button>
        <button type="button" data-ar="365" aria-pressed="false">1Y</button>
        <button type="button" data-ar="0" aria-pressed="true">Tümü</button>
      </div>
      <button type="button" class="ig-katman" data-bant aria-pressed="true" title="İlan dönemlerini şeritle göster"><i class="ig-bant-i"></i>Dönemler</button>
      <button type="button" class="ig-ikon" data-tam title="Tam ekran" aria-label="Tam ekran"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg></button>
      <button type="button" class="ig-ikon" data-png title="PNG indir" aria-label="Grafiği PNG olarak indir"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg></button>
    </div>
  </div>
  <dl class="ig-olcu" data-olcu></dl>
  <div class="ig-kap">
    <div class="ig-grafik" data-grafik></div>
    <div class="ig-marka" aria-hidden="true" set:html={tohumIsaretiSvg({ boyut: 180 })} />
  </div>
  <p class="ig-ipucu" data-ig-js hidden>Fare tekerleği ya da iki parmakla yakınlaştırın; üzerine gelince o günün değerleri yukarıda görünür. Başlıklara tıklayınca seri açılıp kapanır. Kesik çizgiler: dağıtım fiyatı ve İTO enflasyonuna göre fiyat.{donemler.length > 0 && ' Açık şeritler ilan dönemleridir; "Dönem ortalaması" çizgileri her dönemdeki en düşük ve medyan satış ilanlarının ortalamasıdır.'}</p>
  <details class="ig-tablo">
    <summary>Rakamları göster</summary>
    <div class="ig-tablo-kap">
      <table>
        <thead><tr><th scope="col">Tarih</th><th scope="col">ENDU</th><th scope="col">Medyan satış</th><th scope="col">ENYU</th><th scope="col">Medyan alış</th></tr></thead>
        <tbody>
          {[...seri].reverse().map((p) => (
            <tr><th scope="row">{tarihYaz(p.tarih)}</th><td>{fiyatYaz(p.enDusukSatis ?? NaN)}</td><td>{fiyatYaz(p.medyanSatis ?? NaN)}</td><td>{fiyatYaz(p.enYuksekAlis ?? NaN)}</td><td>{fiyatYaz(p.medyanAlis ?? NaN)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
  <script type="application/json" data-ig-veri set:html={JSON.stringify(veri)} />
</section>

<script>
  import { createChart, LineSeries, HistogramSeries, LineType, CrosshairMode } from 'lightweight-charts';

  type Nokta = Record<string, number | null> & { tarih: string };
  const SERI = [
    { a: 'enDusukSatis', ad: 'ENDU · en düşük satış', et: 'ENDU', r: '#141a17', k: 2 },
    { a: 'medyanSatis', ad: 'Medyan satış', et: 'Medyan satış', r: '#9a9f9b', k: 1.5 },
    { a: 'enYuksekAlis', ad: 'ENYU · en yüksek alış', et: 'ENYU', r: '#2d4fd6', k: 2 },
    { a: 'medyanAlis', ad: 'Medyan alış', et: 'Medyan alış', r: '#9fb0ea', k: 1.5 },
    { a: 'donemOrt', ad: 'Dönem ortalaması · ENDU', r: '#c2502b', k: 2, ort: 'enDusukSatis' },
    { a: 'donemMed', ad: 'Dönem ortalaması · medyan', r: '#5d645f', k: 2, ort: 'medyanSatis' },
  ];
  const fyO = (n: number | null | undefined, o = 2) => (n == null ? '—' : n.toLocaleString('tr-TR', { minimumFractionDigits: o, maximumFractionDigits: o }));
  const uzun = (t: string) => new Date(`${t}T12:00:00`).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
  const yz = (n: number | null | undefined, r: number | null) => {
    if (n == null || !r) return '';
    const y = Math.trunc(((n - r) / r) * 1e4) / 100;
    return `<small class="${y < 0 ? 'eks' : y > 0 ? 'art' : ''}">%${y > 0 ? '+' : y < 0 ? '−' : ''}${Math.abs(y).toLocaleString('tr-TR', { minimumFractionDigits: 2 })}</small>`;
  };

  for (const kok of document.querySelectorAll<HTMLElement>('[data-ig]')) {
    type Kur = { gun: (number | null)[]; bas: number | null; son: number | null };
    const V = JSON.parse(kok.querySelector('[data-ig-veri]')!.textContent!) as { kod: string; unvan: string | null; seri: Nokta[]; dagitim: number | null; itoEnf: number | null; kur: Record<string, Kur>; donemler: { acilis: string; kapanis: string }[] };
    let para = 'tl';
    const donemNo = (t: string) => V.donemler.findIndex((d) => t >= d.acilis && t <= d.kapanis);
    const carpan = (_p: string) => 1; // altın gram olarak çizilir
    const cevir = (deger: number | null | undefined, i: number, p: string) => {
      if (deger == null) return null;
      if (p === 'tl') return deger;
      const k = V.kur[p]?.gun[i];
      return k ? (deger / k) * carpan(p) : null;
    };
    const cevirSabit = (deger: number | null, hangi: 'bas' | 'son', p: string) => {
      if (deger == null) return null;
      if (p === 'tl') return deger;
      const k = V.kur[p]?.[hangi];
      return k ? (deger / k) * carpan(p) : null;
    };
    const BIRIM: Record<string, string> = { tl: 'TL', usd: 'dolar', eur: 'avro', xau: 'gram altın' };
    const ISARET: Record<string, [string, string]> = { tl: ['₺', ''], usd: ['$', ''], eur: ['€', ''], xau: ['', ' gr'] };
    const ond = (p: string) => (p === 'xau' ? 4 : p === 'usd' || p === 'eur' ? 3 : 2);
    const fy = (n: number | null | undefined) => (n == null ? '—' : para === 'xau' ? `${n.toLocaleString('tr-TR', { minimumSignificantDigits: 3, maximumSignificantDigits: 3 })} gr` : `${ISARET[para][0]}${fyO(n, ond(para))}${ISARET[para][1]}`);
    const el = kok.querySelector<HTMLElement>('[data-grafik]')!;
    const olcu = kok.querySelector<HTMLElement>('[data-olcu]')!;
    kok.querySelectorAll<HTMLElement>('[data-ig-js]').forEach((x) => (x.hidden = false));
    const aktif = SERI.filter((s) => (s.ort ? V.donemler.length > 0 && V.seri.some((p) => p[s.ort as string] != null && donemNo(p.tarih) >= 0) : V.seri.some((p) => p[s.a] != null)));
    const harita = new Map(V.seri.map((p) => [p.tarih, p]));

    const g = createChart(el, {
      autoSize: true,
      layout: { background: { color: 'transparent' }, textColor: '#3b413d', fontFamily: "'Schibsted Grotesk', Arial, sans-serif", fontSize: 12, attributionLogo: false },
      grid: { vertLines: { visible: false }, horzLines: { color: '#ece9e1' } },
      rightPriceScale: { borderVisible: false, scaleMargins: { top: 0.08, bottom: 0.06 } },
      timeScale: { borderVisible: false, rightOffset: 4, minBarSpacing: 0.5 },
      crosshair: { mode: CrosshairMode.Magnet, vertLine: { color: '#5d645f', style: 3, labelBackgroundColor: '#141a17' }, horzLine: { color: '#5d645f', style: 3, labelBackgroundColor: '#141a17' } },
      localization: { locale: 'tr-TR', priceFormatter: (n: number) => fy(n), dateFormat: 'dd MMM yyyy' },
    });
    // Dönem şeridi: ayrı, görünmez bir fiyat ekseninde tam boy sütunlar; çizgilerin arkasında kalsın diye önce eklenir.
    const bant = g.addSeries(HistogramSeries, { priceScaleId: 'bant', priceLineVisible: false, lastValueVisible: false, base: 0 });
    g.priceScale('bant').applyOptions({ scaleMargins: { top: 0, bottom: 0 }, visible: false });
    bant.setData(V.seri.map((p) => { const i = donemNo(p.tarih); return i < 0 ? { time: p.tarih } : { time: p.tarih, value: 1, color: i % 2 ? 'rgba(232,180,12,0)' : 'rgba(232,180,12,0.16)' }; }) as never);
    const seriler: Record<string, ReturnType<typeof g.addSeries>> = {};
    for (const s of aktif) {
      seriler[s.a] = g.addSeries(LineSeries, { color: s.r, lineWidth: s.k as 1, lineStyle: s.ort ? 2 : 0, priceLineVisible: false, lastValueVisible: !s.ort, title: (s as { et?: string }).et ?? '', crosshairMarkerRadius: 4, lineType: LineType.WithSteps, lineVisible: s.ort || V.seri.filter((p) => p[s.a] != null).length > 1, pointMarkersVisible: !s.ort && V.seri.filter((p) => p[s.a] != null).length === 1, pointMarkersRadius: 3, visible: !s.ort });
    }
    const ana = seriler.enDusukSatis ?? Object.values(seriler)[0];
    let cizgiler: any[] = [];
    let gorunen: Nokta[] = V.seri;
    let dagitimP: number | null = V.dagitim;
    const ciz = () => {
      gorunen = V.seri.map((n, i) => ({ ...n, ...Object.fromEntries(aktif.filter((s) => !s.ort).map((s) => [s.a, cevir(n[s.a] as number | null, i, para)])) }) as Nokta);
      // dönem ortalamaları: seçili birimdeki günlük ENDU'ların ve medyanların dönem içi ortalaması
      for (const s of aktif.filter((x) => x.ort)) {
        const alan = s.ort as string;
        const ort = V.donemler.map((_, i) => { const d = gorunen.filter((p) => donemNo(p.tarih) === i && p[alan] != null).map((p) => p[alan] as number); return d.length ? d.reduce((t, x) => t + x, 0) / d.length : null; });
        for (const p of gorunen) { const i = donemNo(p.tarih); p[s.a] = i >= 0 ? ort[i] : null; }
      }
      for (const s of aktif)
        seriler[s.a].setData(s.ort
          ? (gorunen.map((p) => (p[s.a] == null ? { time: p.tarih } : { time: p.tarih, value: p[s.a] })) as never)
          : gorunen.filter((p) => p[s.a] != null).map((p) => ({ time: p.tarih, value: p[s.a] as number })));
      for (const c of cizgiler) ana?.removePriceLine(c);
      cizgiler = [];
      dagitimP = cevirSabit(V.dagitim, 'bas', para);
      const ito = cevirSabit(V.itoEnf, 'son', para);
      if (ana && dagitimP != null) cizgiler.push(ana.createPriceLine({ price: dagitimP, color: '#e8b40c', lineWidth: 2, lineStyle: 2, axisLabelVisible: true, title: 'Dağıtım' }));
      if (ana && ito != null) cizgiler.push(ana.createPriceLine({ price: ito, color: '#b07d00', lineWidth: 1, lineStyle: 1, axisLabelVisible: true, title: 'İTO enf.' }));
      g.applyOptions({ localization: { locale: 'tr-TR', priceFormatter: (n: number) => fy(n), dateFormat: 'dd MMM yyyy' } });
      const etiket = kok.querySelector('[data-ig-birim]');
      if (etiket) etiket.textContent = BIRIM[para];
      harita.clear();
      for (const n of gorunen) harita.set(n.tarih, n);
    };
    ciz();

    const sonDeger = (a: string) => [...gorunen].reverse().find((p) => p[a] != null);
    const sonTarih = 'Son değer';
    const yaz = (p: Nokta | null, baslik: string) => {
      olcu.innerHTML =
        `<div><dt>Tarih</dt><dd class="ig-t">${baslik}</dd></div>` +
        aktif
          .map((s) => {
            const v = p ? p[s.a] : s.ort ? ([...gorunen].reverse().find((x) => x[s.a] != null)?.[s.a] ?? null) : sonDeger(s.a)?.[s.a];
            const acik = seriler[s.a].options().visible;
            return `<div data-s="${s.a}" class="${acik ? '' : 'kapali'}" role="button" tabindex="0" aria-pressed="${acik}"><dt><i data-r="${s.r}"></i>${s.ad}</dt><dd>${fy(v)}${s.a === 'enDusukSatis' || s.a === 'enYuksekAlis' ? yz(v, dagitimP) : ''}</dd></div>`;
          })
          .join('');
      for (const i of olcu.querySelectorAll<HTMLElement>('i[data-r]')) i.style.setProperty('--r', i.dataset.r!);
    };
    yaz(null, sonTarih);
    g.subscribeCrosshairMove((e) => {
      if (!e.time) return yaz(null, sonTarih);
      const t = String(e.time);
      yaz(harita.get(t) ?? ({ tarih: t } as Nokta), uzun(t));
    });
    const degistir = (d: HTMLElement) => {
      const x = seriler[d.dataset.s!];
      x.applyOptions({ visible: !x.options().visible });
      yaz(null, sonTarih);
    };
    olcu.addEventListener('click', (e) => { const d = (e.target as HTMLElement).closest<HTMLElement>('[data-s]'); if (d) degistir(d); });
    olcu.addEventListener('keydown', (e) => { const d = (e.target as HTMLElement).closest<HTMLElement>('[data-s]'); if (d && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); degistir(d); } });

    const tarih = (gun: number) => new Date(gun * 864e5).toISOString().slice(0, 10);
    // Son değerin sağında boşluk: eksendeki ad etiketleri (ENDU, Dağıtım…) çizginin üstüne binmesin.
    const BOSLUK = 96; // piksel
    const sigdir = (ilkSira: number) => {
      const genislik = Math.max(200, el.clientWidth - g.priceScale('right').width());
      const aralik = Math.max(1, V.seri.length - 1 - ilkSira);
      const ek = (BOSLUK * aralik) / Math.max(1, genislik - BOSLUK);
      g.timeScale().setVisibleLogicalRange({ from: ilkSira - 0.5, to: V.seri.length - 1 + ek });
    };
    const son = Date.parse(`${V.seri.at(-1)!.tarih}T00:00:00Z`) / 864e5;
    kok.querySelectorAll<HTMLButtonElement>('[data-ar]').forEach((b) =>
      b.addEventListener('click', () => {
        kok.querySelectorAll('[data-ar]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        const n = Number(b.dataset.ar);
        if (!n) return sigdir(0);
        const bas = tarih(son - n);
        sigdir(Math.max(0, V.seri.findIndex((p) => p.tarih >= bas)));
      }),
    );
    const bantDugme = kok.querySelector<HTMLButtonElement>('[data-bant]')!;
    bantDugme.addEventListener('click', () => {
      const acik = bantDugme.getAttribute('aria-pressed') !== 'true';
      bantDugme.setAttribute('aria-pressed', String(acik));
      bant.applyOptions({ visible: acik });
    });
    if (!V.donemler.length) bantDugme.hidden = true;
    kok.querySelector('[data-tam]')!.addEventListener('click', () => kok.classList.toggle('tam'));
    // Paylaşılabilir görsel (Excel GRAVER'in yerini tutar): başlıkta kod ve tam unvan, açık serilerin açıklaması,
    // altta görünen tarih aralığı ve kaynak. Grafiğin kendisi takeScreenshot ile aynen alınır.
    kok.querySelector('[data-png]')!.addEventListener('click', () => {
      const shot = g.takeScreenshot();
      const k = shot.width / Math.max(1, kok.querySelector<HTMLElement>('[data-grafik]')!.clientWidth);
      const pad = 28 * k, ust = 112 * k, alt = 54 * k;
      const c = document.createElement('canvas');
      c.width = shot.width + pad * 2;
      c.height = shot.height + ust + alt;
      const x = c.getContext('2d')!;
      const yazi = getComputedStyle(document.body).fontFamily;
      const f = (boy: number, kalin = 400) => `${kalin} ${boy * k}px ${yazi}`;
      x.fillStyle = '#ffffff';
      x.fillRect(0, 0, c.width, c.height);
      x.fillStyle = '#e8b40c';
      x.fillRect(0, 0, c.width, 8 * k);
      x.textBaseline = 'alphabetic';
      x.fillStyle = '#141a17';
      x.font = f(30, 700);
      x.fillText(V.kod.replace('-', ' '), pad, 50 * k);
      x.fillStyle = '#5d645f';
      x.font = f(13, 600);
      if (V.unvan) x.fillText(V.unvan, pad, 72 * k);
      // açık serilerin açıklaması
      let lx = pad;
      x.font = f(12, 600);
      for (const s of aktif) {
        if (!seriler[s.a].options().visible) continue;
        x.fillStyle = s.r;
        x.fillRect(lx, 92 * k, 16 * k, 3 * k);
        x.fillStyle = '#141a17';
        x.fillText(s.ad, lx + 22 * k, 97 * k);
        lx += 22 * k + x.measureText(s.ad).width + 22 * k;
      }
      if (bant.options().visible && V.donemler.length) {
        x.fillStyle = 'rgba(232,180,12,0.35)';
        x.fillRect(lx, 86 * k, 14 * k, 14 * k);
        x.fillStyle = '#141a17';
        x.fillText('İlan dönemi', lx + 20 * k, 97 * k);
      }
      x.drawImage(shot, pad, ust);
      const ar = g.timeScale().getVisibleRange();
      const t = (z: unknown) => new Date(`${String(z)}T12:00:00`).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
      x.fillStyle = '#5d645f';
      x.font = f(12);
      x.fillText(`${ar ? `${t(ar.from)} – ${t(ar.to)} · ` : ''}Günlük · ${BIRIM[para]} · Kaynak: kamuya açık pay ilanları; gerçekleşen işlem fiyatı değildir.`, pad, shot.height + ust + 30 * k);
      x.fillStyle = '#141a17';
      x.font = f(13, 700);
      x.textAlign = 'right';
      x.fillText('kifobu.com/sekundery', c.width - pad, shot.height + ust + 30 * k);
      const a = document.createElement('a');
      a.href = c.toDataURL('image/png');
      a.download = `kifobu-sekundery-${V.kod}.png`;
      a.click();
    });
    const paraUygula = (p: string) => {
      if (!['tl', 'usd', 'eur', 'xau'].includes(p) || (p !== 'tl' && !V.kur[p]?.bas)) p = 'tl';
      para = p;
      ciz();
      yaz(null, sonTarih);
    };
    document.addEventListener('sekundery-para', (e) => { const p = (e as CustomEvent).detail; if (p !== para) paraUygula(p); });
    const ilk = document.documentElement.dataset.para;
    if (ilk && ilk !== 'tl') paraUygula(ilk);
    requestAnimationFrame(() => sigdir(0));
  }
</script>

<style>
  .ig { background: var(--beyaz); border: 1px solid var(--cizgi); padding: 18px 18px 12px; margin-bottom: 40px; }
  .ig.tam { position: fixed; inset: 0; z-index: 60; overflow: auto; margin: 0; }
  .ig.tam .ig-grafik { height: calc(100vh - 240px); }
  .ig-ust { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .ig h2 { margin: 0; font-size: 1.35rem; letter-spacing: -0.01em; }
  .ig-alt { margin: 2px 0 0; color: var(--gri); font-size: 0.88rem; }
  .ig-dugmeler { display: flex; gap: 8px; flex-wrap: wrap; }
  .ig-dugmeler[hidden], .ig-ipucu[hidden] { display: none; }
  .ig-tf { display: inline-flex; border: 1.5px solid var(--murekkep); }
  .ig-tf button { font: inherit; font-size: 0.85rem; padding: 6px 11px; border: 0; background: transparent; color: var(--murekkep); cursor: pointer; }
  .ig-tf button + button { border-left: 1.5px solid var(--murekkep); }
