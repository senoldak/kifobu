---
/**
 * Bugün Tahtası - Anasayfa İçin Zarif Girişimler Tahtası
 * - Bulten.ts verisinden beslenir (BULTEN.girisimler).
 * - Sadece girişimleri gösterir (Platformlar, Ön Talep ve MKK verileri "Günlük Bülten" sayfasına taşındı).
 * - Eski İMKB tebeşir tahtası estetiğinde, kompakt ve zarif tablo.
 * - Renkli ilerleme yüzdeleri ve mini barlar ile zenginleştirildi.
 */
import { BULTEN } from '../data/bulten';
import { newsUrl, type Haber } from '../lib/news';

interface Props {
  breaking?: Haber[];
}

const { breaking = [] } = Astro.props;
const b = BULTEN;

const tl = (n: number) => '₺' + n.toLocaleString('tr-TR');
const yuzde = (n: number) =>
  n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%';

const cubukSinifi = (y: number) => {
  if (y >= 100) return 'renk-yesil';
  if (y >= 50) return 'renk-mavi';
  return 'renk-indigo';
};

const slug = (str: string) =>
  str.toLowerCase().replace(/[^a-z0-9]/g, '');
---

<section class="bugun-tahta" aria-label="Günün Girişimleri">
  <!-- Üst Bar: Başlık ve Bültene Geçiş -->
  <div class="bt-baslik-satiri">
    <div class="bt-baslik-sol">
      <span class="bt-tarih">{b.tarih}</span>
      <span class="bt-sayac">Bülten {b.sayi}</span>
    </div>
    <div class="bt-baslik-sag">
      <a href="/gunluk-bulten/" class="bt-link-bulten">
        Tüm bülten &amp; platformlar <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <!-- Zarif Tebeşir Tablosu -->
  <div class="bt-tablo-sarma">
    <table class="bt-tablo">
      <thead>
        <tr>
          <th scope="col" class="kol-durum">Durum</th>
          <th scope="col" class="kol-girisim">Girişim</th>
          <th scope="col" class="kol-platform">Platform</th>
          <th scope="col" class="kol-rakam kol-bugun">Bugün</th>
          <th scope="col" class="kol-rakam">Alınan</th>
          <th scope="col" class="kol-rakam kol-degerleme">Değerleme</th>
          <th scope="col" class="kol-rakam kol-kalan">Kalan</th>
          <th scope="col" class="kol-yuzde">%</th>
        </tr>
      </thead>
      <tbody>
        {
          b.girisimler.map((g) => (
            <tr class={`satir-${slug(g.ad)}`}>
              <td class="kol-durum">
                <span class={`durum-rozet rozet-${slug(g.durum)}`}>{g.durum}</span>
              </td>
              <th scope="row" class="kol-girisim">
                {g.url ? <a href={g.url}>{g.ad}</a> : <span>{g.ad}</span>}
              </th>
              <td class="kol-platform">
                <span class={`plat-etiket plat-${slug(g.platform)}`}>{g.platform}</span>
              </td>
              <td class="kol-rakam kol-bugun">
                {g.bugun > 0 ? <strong class="vurgu-bugun">{tl(g.bugun)}</strong> : <span class="soluk">₺0</span>}
              </td>
              <td class="kol-rakam">
                <strong class="rakam-vurgu">{tl(g.alinan)}</strong>
              </td>
              <td class="kol-rakam kol-degerleme">
                <span>{tl(g.degerleme)}</span>
              </td>
              <td class="kol-rakam kol-kalan">
                {g.kalan === null ? (
                  <span class="fonlandi-metin">FONLANDI</span>
                ) : (
                  <span>{tl(g.kalan)}</span>
                )}
              </td>
              <td class="kol-yuzde">
                <div class="yuzde-hucre">
                  <span class={`yuzde-sayi ${cubukSinifi(g.yuzde)}`}>{yuzde(g.yuzde)}</span>
                  <div class="mini-bar-track" aria-hidden="true">
                    <div class={`mini-bar-fill gk-bar-${slug(g.ad)} ${cubukSinifi(g.yuzde)}`} />
                  </div>
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="bt-arsiv">
    <a href="/arsiv/" class="bt-link-bulten">Arşiv <span aria-hidden="true">&rarr;</span></a>
  </p>

  <!-- Son Dakika Bandı -->
  {
    breaking.length > 0 && (
      <div class="bt-son-dakika" role="region" aria-label="Son dakika">
        <span class="son-dakika-etiket">Son dakika</span>
        <ul>
          {breaking.map((h) => (
            <li>
              <a href={newsUrl(h)}>{h.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .bugun-tahta {
    padding-block: 14px 18px;
    color: var(--tebesir, #ecefe9);
    font-family: var(--yazi-govde, sans-serif);
  }

  /* Üst Başlık Satırı */
  .bt-baslik-satiri {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(236, 239, 233, 0.15);
  }

  .bt-baslik-sol {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .bt-baslik {
    margin: 0;
    font-family: var(--yazi-baslik, sans-serif);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--sari, #f2d45c);
    text-transform: uppercase;
  }

  .bt-ayrac {
    color: rgba(236, 239, 233, 0.3);
  }

  .bt-tarih {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--tebesir-2, rgba(236, 239, 233, 0.8));
  }

  .bt-sayac {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--tebesir-3, rgba(236, 239, 233, 0.55));
    background: rgba(236, 239, 233, 0.08);
    padding: 2px 7px;
    border-radius: 3px;
  }

  .bt-baslik-sag {
    font-size: 0.86rem;
  }

  .bt-link-bulten {
    color: var(--tebesir-2, rgba(236, 239, 233, 0.85));
    text-decoration: none;
    font-family: var(--yazi-baslik, sans-serif);
    font-weight: 700;
    font-size: 0.84rem;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color 0.15s ease;
  }

  .bt-link-bulten:hover {
    color: var(--sari, #f2d45c);
  }

  /* Tablo Sarmalayıcı */
  .bt-tablo-sarma {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* Tablo Tasarımı */
  .bt-tablo {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--yazi-tahta, sans-serif);
    font-variant-numeric: tabular-nums;
    font-size: 0.95rem;
  }

  .bt-tablo thead th {
    padding: 6px 12px;
    font-family: var(--yazi-baslik, sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tebesir-3, rgba(236, 239, 233, 0.6));
    border-bottom: 2px solid rgba(236, 239, 233, 0.2);
    text-align: left;
    white-space: nowrap;
  }

  .bt-tablo tbody th,
  .bt-tablo tbody td {
    padding: 9px 12px;
    border-bottom: 1px solid rgba(236, 239, 233, 0.08);
    vertical-align: middle;
    white-space: nowrap;
  }

  /* Tebeşir Sütun Çizgileri */
  .bt-tablo th + th,
  .bt-tablo td + td,
  .bt-tablo th + td,
  .bt-tablo td + th {
    border-left: 1px solid rgba(236, 239, 233, 0.08);
  }

  .bt-tablo tbody tr:hover {
    background: rgba(236, 239, 233, 0.04);
  }

  /* Sütun Hizalamaları */
  .kol-rakam {
    text-align: right;
  }

  .kol-yuzde {
    text-align: right;
    width: 130px;
    min-width: 110px;
  }

  /* Girişim Adı */
  .kol-girisim {
    text-align: left;
    font-family: var(--yazi-baslik, sans-serif);
    font-weight: 800;
    font-size: 1.02rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--tebesir, #ecefe9);
  }

  .kol-girisim a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .kol-girisim a:hover {
    color: var(--sari, #f2d45c);
    border-bottom-color: var(--sari, #f2d45c);
  }

  /* Platform Etiketleri */
  .plat-etiket {
    font-family: var(--yazi-baslik, sans-serif);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }

  .plat-etiket.plat-fonangels {
    color: #f47b3d !important;
  }
  /* Koyu tahtada okunurluk (WCAG 4.5:1): mor tonlar marka renginin açık hâli. */
  .plat-etiket.plat-fonventure {
    color: #9d99f7 !important;
  }
  .plat-etiket.plat-ecofolio {
    color: #009bae !important;
  }
  .plat-etiket.plat-trinkfon {
    color: #b49af5 !important;
  }

  /* Durum Rozetleri */
  .durum-rozet {
    display: inline-block;
    padding: 2px 7px;
    font-family: var(--yazi-baslik, sans-serif);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    background: rgba(236, 239, 233, 0.07);
    color: var(--tebesir-2, rgba(236, 239, 233, 0.85));
  }

  .durum-rozet.rozet-sonaerdi {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e !important;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .durum-rozet.rozet-songun {
    background: rgba(242, 212, 92, 0.15);
    color: #f2d45c !important;
    border: 1px solid rgba(242, 212, 92, 0.3);
  }

  .durum-rozet.rozet-ontalep {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8 !important;
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  /* Rakam Vurguları */
  .rakam-vurgu {
    color: var(--tebesir, #ecefe9);
    font-weight: 700;
  }

  .vurgu-bugun {
    color: var(--sari, #f2d45c);
    font-weight: 800;
  }

  .soluk {
    color: var(--tebesir-3, rgba(236, 239, 233, 0.4));
  }

  .fonlandi-metin {
    color: #22c55e !important;
    font-family: var(--yazi-baslik, sans-serif);
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
  }

  /* Yüzde & Mini Bar */
  .yuzde-hucre {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .yuzde-sayi {
    font-weight: 800;
    font-size: 0.96rem;
  }

  .mini-bar-track {
    width: 65px;
    height: 5px;
    background: rgba(236, 239, 233, 0.12);
    border-radius: 2px;
    overflow: hidden;
  }

  .mini-bar-fill {
    height: 100%;
    min-width: 3px;
    border-radius: 2px;
  }

  /* CSP Uyumlu Renk Sınıfları */
  .renk-yesil {
    color: #22c55e !important;
  }
  .mini-bar-fill.renk-yesil {
    background-color: #22c55e !important;
  }

  .renk-mavi {
    color: #38bdf8 !important;
  }
  .mini-bar-fill.renk-mavi {
    background-color: #38bdf8 !important;
  }

  .renk-indigo {
    color: #818cf8 !important;
  }
  .mini-bar-fill.renk-indigo {
    background-color: #818cf8 !important;
  }

  /* Barların Özel Genişlikleri */
  .mini-bar-fill.gk-bar-athleticlabs {
    width: 100% !important;
    background-color: #22c55e !important;
  }
  .mini-bar-fill.gk-bar-oylio {
    width: 50.64% !important;
    background-color: #38bdf8 !important;
  }
  .mini-bar-fill.gk-bar-pupaq {
    width: 2.43% !important;
    background-color: #818cf8 !important;
  }
  .mini-bar-fill.gk-bar-loopyon {
    width: 1.01% !important;
    background-color: #818cf8 !important;
  }
  .mini-bar-fill.gk-bar-kargomcom {
    width: 14.26% !important;
    background-color: #818cf8 !important;
  }

  .bt-arsiv {
    margin: 10px 0 0;
    text-align: right;
  }

  /* Son Dakika Bandı */
  .bt-son-dakika {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px solid rgba(236, 239, 233, 0.15);
    font-family: var(--yazi-baslik, sans-serif);
  }

  .son-dakika-etiket {
    flex: none;
    font-weight: 800;
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tahta, #1d2723);
    background: var(--sari, #f2d45c);
    padding: 2px 7px 1px;
    border-radius: 2px;
  }

  .bt-son-dakika ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .bt-son-dakika a {
    color: inherit;
    text-decoration: none;
  }

  .bt-son-dakika a:hover {
    color: var(--sari, #f2d45c);
  }

  /* Responsive / Mobil */
  @media (max-width: 768px) {
    .kol-degerleme,
    .kol-bugun {
      display: none;
    }

    .bt-tablo tbody th,
    .bt-tablo tbody td {
      padding: 7px 8px;
    }
  }

  @media (max-width: 520px) {
    .kol-kalan {
      display: none;
    }

    .bt-baslik-satiri {
      flex-direction: column;
      gap: 6px;
      align-items: flex-start;
    }
  }
</style>
