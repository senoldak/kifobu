---
/**
 * Günlük Kitle Fonlama Bülteni ("Bugün" görünümü)
 * Görseldeki infografik düzeniyle birebir:
 * - Girişimler: 2 satırlı ilerleme kartları
 * - Platformlar: Segmentli dağılım çubuğu + 4 sütun döküm
 * - Ön Talep & Yakında: Temiz tipografik sütunlar
 * - MKK Verileri: Yatay rozet bandı
 */
import { BULTEN } from '../data/bulten';
import { formatNumber } from '../lib/site';
import { newsUrl, type Haber } from '../lib/news';

interface Props {
  breaking?: Haber[];
}

const { breaking = [] } = Astro.props;
const b = BULTEN;

const tl = (n: number) => '₺' + n.toLocaleString('tr-TR');
const yuzde = (n: number) =>
  n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%';

// Platform dağılımı toplamı
const platformToplami = b.platformlar.liste.reduce((s, p) => s + p.toplam, 0) || 1;

// CSP (style-src 'self') satır içi style'ı engellediği için çubuklar SVG
// öznitelikleriyle çizilir; segmentlerin başlangıç noktaları önceden hesaplanır.
let platformX = 0;
const platformSegmentleri = b.platformlar.liste.map((p) => {
  const oran = (p.toplam / platformToplami) * 100;
  const s = { p, x: platformX, oran };
  platformX += oran;
  return s;
});

// İlerleme çubuğu rengi
const cubukRengi = (y: number) => {
  if (y >= 100) return '#22c55e'; // Yeşil (fonlandı/sona erdi)
  if (y >= 50) return '#38bdf8';  // Açık mavi
  return '#818cf8';               // İndigo
};

const cubukSinifi = (y: number) => {
  if (y >= 100) return 'renk-yesil';
  if (y >= 50) return 'renk-mavi';
  return 'renk-indigo';
};

const slug = (str: string) =>
  str.toLowerCase().replace(/[^a-z0-9]/g, '');
---

<section class="bulten-alani" aria-label="Günlük Kitle Fonlama Bülteni">
  <!-- Üst Başlık -->
  <header class="bulten-baslik">
    <div>
      <h2 class="bulten-ana-baslik">GÜNLÜK KİTLE FONLAMA BÜLTENİ</h2>
      <p class="bulten-tarih-sayi">{b.tarih} / {b.sayi}</p>
    </div>
  </header>

  <!-- GİRİŞİMLER -->
  <section class="bulten-bolum">
    <div class="bolum-baslik">
      <h3>GİRİŞİMLER</h3>
      <span class="bolum-cizgi"></span>
    </div>

    <div class="girisimler-liste">
      {
        b.girisimler.map((g) => (
          <article class="girisim-karti">
            <!-- Üst Satır -->
            <div class="gk-satir gk-ust">
              <div class="gk-ad">
                {g.url ? <a href={g.url}>{g.ad}</a> : <span>{g.ad}</span>}
              </div>
              <div class="gk-metrik">
                <span class="etiket">bugün</span>
                <span class="ayrac">|</span>
                <span class="deger">{tl(g.bugun)}</span>
              </div>
              <div class="gk-metrik gk-metrik-sag">
                <span class="deger">{tl(g.alinan)}</span>
                <span class="ayrac">|</span>
                <span class="etiket">alınan</span>
              </div>
              <div class={`gk-yuzde ${cubukSinifi(g.yuzde)}`} style={`color: ${cubukRengi(g.yuzde)}`}>
                {yuzde(g.yuzde)}
              </div>
            </div>

            <!-- İlerleme Çubuğu -->
            <div class="gk-cubuk-alani" role="progressbar" aria-valuenow={g.yuzde} aria-valuemin="0" aria-valuemax="100">
              <svg class="cubuk-svg" aria-hidden="true">
                <rect
                  class={`gk-bar-${slug(g.ad)}`}
                  width={`${Math.min(g.yuzde, 100)}%`}
                  height="100%"
                  rx="3"
                  fill={cubukRengi(g.yuzde)}
                />
              </svg>
            </div>

            <!-- Alt Satır -->
            <div class="gk-satir gk-alt">
              <div class="gk-platform">{g.platform}</div>
              <div class="gk-metrik">
                <span class="etiket">değerleme</span>
                <span class="ayrac">|</span>
                <span class="deger">{tl(g.degerleme)}</span>
              </div>
              <div class="gk-metrik gk-metrik-sag">
                {g.kalan === null ? (
                  <span class="deger vurgu-fonlandi">FONLANDI</span>
                ) : (
                  <span class="deger">{tl(g.kalan)}</span>
                )}
                <span class="ayrac">|</span>
                <span class="etiket">kalan</span>
              </div>
              <div class="gk-durum">{g.durum}</div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- PLATFORMLAR -->
  <section class="bulten-bolum">
    <div class="bolum-baslik">
      <h3>PLATFORMLAR</h3>
      <span class="bolum-cizgi"></span>
    </div>

    <div class="platformlar-govde">
      <!-- Rakamlar (Sol: Bugün, Sağ: Toplam) -->
      <div class="platformlar-sayaclar">
        <div class="sayac-kutu sayac-sol">
          <span class="sayac-etiket">bugün</span>
          <span class="sayac-deger">{tl(b.platformlar.bugun)}</span>
        </div>
        <div class="sayac-kutu sayac-sag">
          <span class="sayac-etiket">toplam</span>
          <span class="sayac-deger">{tl(b.platformlar.toplam)}</span>
        </div>
      </div>

      <!-- Segmentli Dağılım Çubuğu -->
      <div class="platform-segment-cubuk" aria-hidden="true">
        <svg class="cubuk-svg">
          {
            platformSegmentleri.map((s) => (
              <rect
                class={`segment plat-${slug(s.p.ad)}`}
                x={`${s.x}%`}
                width={`${s.oran}%`}
                height="100%"
                fill={s.p.renk}
              >
                <title>{`${s.p.ad}: ${tl(s.p.toplam)}`}</title>
              </rect>
            ))
          }
        </svg>
      </div>

      <!-- 4 Platform Sütun Listesi -->
      <div class="platform-kartlar-izgara">
        {
          b.platformlar.liste.map((p) => (
            <div class="platform-kolon">
              <span class={`pk-ad plat-${slug(p.ad)}`} style={`color: ${p.renk}`}>
                {p.url ? <a href={p.url}>{p.ad}</a> : p.ad}
              </span>
              <span class="pk-tutar">{tl(p.toplam)}</span>
              <span class="pk-adet">{p.girisim} girişim</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ÖN TALEP & YAKINDA -->
  <section class="bulten-bolum">
    <div class="bolum-baslik">
      <h3>ÖN TALEP &amp; YAKINDA</h3>
      <span class="bolum-cizgi"></span>
    </div>

    <div class="yakinda-izgara">
      {
        b.yakinda.map((y) => (
          <div class="yakinda-oge">
            <span class="yo-ad">
              {y.url ? <a href={y.url}>{y.ad}</a> : y.ad}
            </span>
            <span class="yo-plat">{y.platform}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- MKK VERİLERİ -->
  <section class="bulten-bolum">
    <div class="bolum-baslik">
      <h3>MKK VERİLERİ</h3>
      <span class="bolum-cizgi"></span>
    </div>

    <div class="mkk-serit">
      <div class="mkk-hucre">
        <span class="mkk-lbl">platform</span>
        <strong class="mkk-val">{b.mkk.platform}</strong>
      </div>
      <div class="mkk-hucre">
        <span class="mkk-lbl">yatırımcı sayısı</span>
        <strong class="mkk-val">{formatNumber(b.mkk.yatirimci)}</strong>
      </div>
      <div class="mkk-hucre">
        <span class="mkk-lbl">kaydileşen şirket</span>
        <strong class="mkk-val">{b.mkk.sirket}</strong>
      </div>
      <div class="mkk-hucre">
        <span class="mkk-lbl">toplanan fon</span>
        <strong class="mkk-val">{b.mkk.fon}</strong>
      </div>
    </div>
  </section>

  <!-- Son Dakika -->
  {
    breaking.length > 0 && (
      <div class="bulten-son-dakika" role="region" aria-label="Son dakika">
        <span class="son-dakika-etiket">Son dakika</span>
        <ul>
          {breaking.map((h) => (
            <li>
              <a href={newsUrl(h)}>{h.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .bulten-alani {
    padding-block: 20px 24px;
    color: var(--tebesir, #ecefe9);
    font-family: var(--yazi-govde, sans-serif);
  }

  /* Başlık */
  .bulten-baslik {
    margin-bottom: 24px;
  }

  .bulten-ana-baslik {
    margin: 0;
    font-family: var(--yazi-baslik, sans-serif);
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--tebesir, #ecefe9);
    text-transform: uppercase;
  }

  .bulten-tarih-sayi {
    margin: 4px 0 0;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--tebesir-3, rgba(236, 239, 233, 0.6));
  }

  /* Bölüm Başlıkları */
  .bulten-bolum {
    margin-top: 24px;
  }

  .bolum-baslik {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }

  .bolum-baslik h3 {
    margin: 0;
    font-family: var(--yazi-baslik, sans-serif);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sari, #f2d45c);
    white-space: nowrap;
  }

  .bolum-cizgi {
    flex: 1;
    height: 1px;
    background: var(--tebesir-cizgi, rgba(236, 239, 233, 0.2));
  }

  /* Girişimler Listesi */
  .girisimler-liste {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .girisim-karti {
    background: rgba(236, 239, 233, 0.035);
    border: 1px solid rgba(236, 239, 233, 0.08);
    border-radius: 4px;
    padding: 8px 14px;
    transition: background 0.15s ease;
  }

  .girisim-karti:hover {
    background: rgba(236, 239, 233, 0.06);
  }

  .gk-satir {
    display: grid;
    grid-template-columns: minmax(130px, 1.2fr) minmax(130px, 1fr) minmax(140px, 1fr) minmax(80px, auto);
    align-items: baseline;
    gap: 12px;
    font-size: 0.88rem;
  }

  .gk-ust {
    margin-bottom: 6px;
  }

  .gk-alt {
    margin-top: 6px;
  }

  .gk-ad {
    font-family: var(--yazi-baslik, sans-serif);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--tebesir, #ecefe9);
  }

  .gk-ad a {
    color: inherit;
    text-decoration: none;
  }

  .gk-ad a:hover {
    color: var(--sari, #f2d45c);
  }

  .gk-platform {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--tebesir-3, rgba(236, 239, 233, 0.6));
  }

  .gk-metrik {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-variant-numeric: tabular-nums;
  }

  .gk-metrik-sag {
    justify-content: flex-start;
  }

  .gk-metrik .etiket {
    color: var(--tebesir-3, rgba(236, 239, 233, 0.55));
    font-size: 0.82rem;
  }

  .gk-metrik .ayrac {
    color: rgba(236, 239, 233, 0.25);
    font-size: 0.78rem;
  }

  .gk-metrik .deger {
    font-weight: 700;
    color: var(--tebesir, #ecefe9);
  }

  .gk-metrik .vurgu-fonlandi {
    color: #22c55e;
    letter-spacing: 0.05em;
  }

  .gk-yuzde {
    text-align: right;
    font-family: var(--yazi-tahta, sans-serif);
    font-size: 1.15rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .gk-durum {
    text-align: right;
    font-family: var(--yazi-baslik, sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sari, #f2d45c);
  }

  /* İlerleme Çubuğu */
  .gk-cubuk-alani {
    height: 11px;
    background: rgba(236, 239, 233, 0.12);
    border-radius: 3px;
    overflow: hidden;
    margin-block: 3px;
  }

  .cubuk-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Renk Sınıfları */
  .renk-yesil {
    color: #22c55e !important;
  }
  .gk-cubuk-dolgu.renk-yesil {
    background-color: #22c55e !important;
  }

  .renk-mavi {
    color: #38bdf8 !important;
  }
  .gk-cubuk-dolgu.renk-mavi {
    background-color: #38bdf8 !important;
  }

  .renk-indigo {
    color: #818cf8 !important;
  }
  .gk-cubuk-dolgu.renk-indigo {
    background-color: #818cf8 !important;
  }

  /* Platformlar Bölümü */
  .platformlar-govde {
    background: rgba(236, 239, 233, 0.035);
    border: 1px solid rgba(236, 239, 233, 0.08);
    border-radius: 4px;
    padding: 14px 16px;
  }

  .platformlar-sayaclar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 8px;
  }

  .sayac-kutu {
    display: flex;
    flex-direction: column;
  }

  .sayac-sag {
    align-items: flex-end;
  }

  .sayac-etiket {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--tebesir-3, rgba(236, 239, 233, 0.55));
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .sayac-deger {
    font-family: var(--yazi-tahta, sans-serif);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 800;
    color: var(--tebesir, #ecefe9);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .platform-segment-cubuk {
    display: flex;
    height: 12px;
    border-radius: 3px;
    overflow: hidden;
    background: rgba(236, 239, 233, 0.1);
    margin-bottom: 14px;
  }


  .platform-kartlar-izgara {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 12px;
  }

  .platform-kolon {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pk-ad {
    font-family: var(--yazi-baslik, sans-serif);
    font-weight: 800;
    font-size: 0.98rem;
    letter-spacing: 0.02em;
  }

  .pk-ad a {
    color: inherit;
    text-decoration: none;
  }

  .pk-tutar {
    font-family: var(--yazi-tahta, sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--tebesir, #ecefe9);
    font-variant-numeric: tabular-nums;
  }

  .pk-adet {
    font-size: 0.8rem;
    color: var(--tebesir-3, rgba(236, 239, 233, 0.6));
  }

  /* Ön Talep & Yakında */
  .yakinda-izgara {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
  }

  .yakinda-oge {
    display: flex;
    flex-direction: column;
    padding: 8px 12px;
    background: rgba(236, 239, 233, 0.035);
    border: 1px solid rgba(236, 239, 233, 0.08);
    border-radius: 4px;
  }

  .yo-ad {
    font-family: var(--yazi-baslik, sans-serif);
    font-weight: 800;
    font-size: 0.98rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--tebesir, #ecefe9);
  }

  .yo-ad a {
    color: inherit;
    text-decoration: none;
  }

  .yo-plat {
    font-size: 0.82rem;
    color: var(--tebesir-3, rgba(236, 239, 233, 0.6));
  }

  /* MKK Verileri Şeridi */
  .mkk-serit {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: rgba(236, 239, 233, 0.05);
    border: 1px solid rgba(236, 239, 233, 0.1);
    border-radius: 4px;
    padding: 10px 14px;
    gap: 8px;
  }

  .mkk-hucre {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    font-size: 0.9rem;
  }

  .mkk-hucre + .mkk-hucre {
    border-left: 1px solid rgba(236, 239, 233, 0.12);
  }

  .mkk-lbl {
    color: var(--tebesir-3, rgba(236, 239, 233, 0.6));
    font-size: 0.82rem;
  }

  .mkk-val {
    color: var(--tebesir, #ecefe9);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  /* Son Dakika */
  .bulten-son-dakika {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-top: 24px;
    padding-top: 14px;
    border-top: 1px solid var(--tebesir-cizgi, rgba(236, 239, 233, 0.2));
    font-family: var(--yazi-baslik, sans-serif);
  }

  .son-dakika-etiket {
    flex: none;
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tahta, #1d2723);
    background: var(--sari, #f2d45c);
    padding: 3px 8px 2px;
    border-radius: 2px;
  }

  .bulten-son-dakika ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    font-weight: 700;
    font-size: 0.98rem;
  }

  .bulten-son-dakika a {
    color: inherit;
    text-decoration: none;
  }

  .bulten-son-dakika a:hover {
    color: var(--sari, #f2d45c);
  }

  /* Mobil Uyumluluk */
  @media (max-width: 768px) {
    .gk-satir {
      grid-template-columns: 1fr 1fr;
      row-gap: 4px;
    }

    .gk-metrik-sag,
    .gk-yuzde,
    .gk-durum {
      justify-self: end;
      text-align: right;
    }

    .platform-kartlar-izgara {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .mkk-serit {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 10px;
    }

    .mkk-hucre + .mkk-hucre {
      border-left: none;
    }
  }

  @media (max-width: 480px) {
    .gk-satir {
      grid-template-columns: 1fr;
    }

    .gk-metrik-sag,
    .gk-yuzde,
    .gk-durum {
      justify-self: start;
      text-align: left;
    }

    .platform-kartlar-izgara {
      grid-template-columns: 1fr;
    }

    .mkk-serit {
      grid-template-columns: 1fr;
    }
  }
</style>