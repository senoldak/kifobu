---
// "Kısaca": başlığın altında, sarı üst bantlı kutu; "Neden önemli" ve en çok üç numaralı madde. Haberde ikisi de yoksa
// kutu çıkmaz. tidsrøst src/components/artikkel/KortOppsummert.astro uyarlaması.
interface Props {
  whyMatters?: string;
  keyPoints?: string[];
}
const { whyMatters, keyPoints } = Astro.props;
const neden = (whyMatters || '').trim();
const maddeler = (Array.isArray(keyPoints) ? keyPoints : []).map((p) => (p || '').trim()).filter(Boolean).slice(0, 3);
---

{
  (neden || maddeler.length > 0) && (
    <section class="yh-kisaca" aria-labelledby="kisaca-b">
      <h2 class="yh-etiket" id="kisaca-b">Kısaca</h2>
      {neden && (
        <div class="neden">
          <h3>Neden önemli</h3>
          <p>{neden}</p>
        </div>
      )}
      {maddeler.length > 0 && (
        <ol class:list={[maddeler.length === 1 && 'n1', maddeler.length === 2 && 'n2']}>
          {maddeler.map((m, i) => (
            <li>
              <span class="no" aria-hidden="true">{i + 1}</span>
              <span>{m}</span>
            </li>
          ))}
        </ol>
      )}
    </section>
  )
}
