---
import { Image } from 'astro:assets';
import Kunye from './Kunye.astro';
import { gorselVar, newsUrl, type Haber } from '../lib/news';

interface Props {
  haber: Haber;
  showCategory?: boolean;
  showSummary?: boolean;
  showImage?: boolean;
  withTime?: boolean;
}

// Listelerde kapak varsayılan olarak gösterilmez (yalnızca manşet ve haber sayfası).
const { haber, showCategory = true, showSummary = true, showImage = false, withTime = false } = Astro.props;
const { title, description, coverAlt } = haber.data;
// Eski haberlerde kapak gösterilmez (bkz. gorselVar).
const cover = gorselVar(haber.data.date) ? haber.data.cover : undefined;
---

<article class:list={['satir', { 'satir-gorselli': showImage && cover }]}>
  {
    showImage && cover && (
      <a href={newsUrl(haber)} class="satir-gorsel" tabindex="-1" aria-hidden="true">
        <Image src={cover} alt="" width={1200} />
      </a>
    )
  }
  <h3><a href={newsUrl(haber)}>{title}</a></h3>
  {showSummary && <p>{description}</p>}
  <Kunye haber={haber} showCategory={showCategory} withTime={withTime} />
</article>
