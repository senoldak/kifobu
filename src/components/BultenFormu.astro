---
// Haftalık e-posta bülteni abonelik formu: altbilgide ve haber sayfasının sonunda. Form Worker'a gider
// (worker/bulten.ts → abonelikIstegi). Gizli tuzak alanı görünmez; botlar doldurursa istek sessizce yok sayılır.
interface Props {
  /** Aynı sayfada birden çok form olduğunda kimlikler çakışmasın diye. */
  kimlik: string;
}
const { kimlik } = Astro.props;
---

<form class="bulten-form" action="/api/bulten/abone" method="post">
  <div class="bulten-satir">
    <label class="bulten-etiket" for={`${kimlik}-eposta`}>E-posta adresiniz</label>
    <input
      class="bulten-girdi"
      id={`${kimlik}-eposta`}
      type="email"
      name="eposta"
      required
      autocomplete="email"
      inputmode="email"
      maxlength="254"
      spellcheck="false"
    />
    <button class="bulten-dugme" type="submit">Abone ol</button>
  </div>
  <div class="bulten-tuzak" aria-hidden="true">
    <label for={`${kimlik}-web`}>Web sitesi</label>
    <input id={`${kimlik}-web`} type="text" name="web" tabindex="-1" autocomplete="off" />
  </div>
  <p class="bulten-not">
    Haftada bir, pazartesi. Adresiniz yalnız bülten için tutulur; her e-postadaki bağlantıyla tek tıkla ayrılırsınız.
    <a href="/gizlilik/">Gizlilik</a>
  </p>
</form>
