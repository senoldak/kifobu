---
interface Props {
  whyMatters?: string;
  keyPoints?: string[];
  description?: string;
}

const { whyMatters, keyPoints } = Astro.props;
const hasContent = Boolean(whyMatters || (keyPoints && keyPoints.length > 0));
---

{
  hasContent && (
    <aside class="sentez-kutu" aria-label="Hızlı Çıkarım ve Önemli Noktalar">
      <div class="sentez-baslik">
        <span class="sentez-rozet">Hızlı Çıkarım</span>
        {whyMatters && (
          <p class="sentez-neden">
            <strong>Neden Önemli?</strong> {whyMatters}
          </p>
        )}
      </div>
      {keyPoints && keyPoints.length > 0 && (
        <div class="sentez-maddeler">
          <span class="sentez-alt-baslik">3 Maddede Özet</span>
          <ul class="sentez-liste">
            {keyPoints.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  )
}
