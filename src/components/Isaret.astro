---
// Tebeşir işareti: kampanya durumunu renkle değil işaretle gösterir.
import { DURUMLAR, type Durum } from '../lib/site';

interface Props {
  durum?: string;
  size?: number;
}

const { durum, size = 22 } = Astro.props;
const label = durum ? DURUMLAR[durum as Durum] : undefined;
---

{
  durum && (
    <svg
      class={`isaret isaret-${durum}`}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      role="img"
      aria-label={label}
    >
      <title>{label}</title>
      {durum === 'basarili' && <path d="M3.6 12.9c1.6 1.2 3.2 3 4.6 5.3.3.5 1 .5 1.2-.1C11.6 12.4 15.3 7.6 20.6 4.2" />}
      {durum === 'yeni' && <path d="M12.6 4.1c-4.3-.4-8.3 2.6-8.5 7-.2 4.6 3.4 8.4 8 8.6 4.5.2 7.9-3.1 7.9-7.4 0-4.1-3.1-7.5-7.6-8.3-1.4-.2-2.6.1-3.5.6" />}
      {durum === 'suruyor' && <path d="M3.5 12.4c4.6-.5 10.4-.6 16.2-.2M14.6 6.9c1.9 1.6 3.8 3.4 5.4 5.3-1.7 1.8-3.5 3.5-5.5 5.1" />}
      {durum === 'basarisiz' && <path d="M3.2 13.1c5.6-1.4 11.6-2.2 17.6-2.4" />}
    </svg>
  )
}
