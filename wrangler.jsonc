{
  // Cloudflare ayarı: site yalnız statik dosyalar olarak yayınlanır (Worker kodu yok).
  "name": "kifobu",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "kifobu.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
