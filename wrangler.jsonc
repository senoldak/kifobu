{
  // Cloudflare ayarı: statik site (dist/) + küçük Worker (yalnız POST /api/fayda, "Bu haber işine yaradı mı?" sayacı).
  "name": "kifobu",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "kifobu.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Yalnız /api/* Worker'dan geçer; sayfalar eskisi gibi doğrudan statik sunulur.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Anonim günlük sayaç (gün + haber + evet/hayır; IP ya da okur bilgisi yok). tidsrøst'ün sayaç veritabanında ayrı
  // tablo: kifobu_fayda (worker/schema.sql).
  "d1_databases": [
    { "binding": "DB", "database_name": "tidsrost-nyttig", "database_id": "74ef0555-fff4-46a3-8443-159661df2a58" }
  ]
}
